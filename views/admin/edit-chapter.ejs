<%- include('../partials/header') %>

<div style="margin-bottom: 1.5rem;">
    <a href="<%= redirect_to %>" style="color: var(--text-secondary); font-size: 0.9rem;">&larr; Quay lại trang trước</a>
</div>

<div class="form-container" style="max-width: 900px; margin: 0 auto;">
    <h2 class="section-title">✏️ Chỉnh Sửa Chương Truyện</h2>
    <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: -0.8rem; margin-bottom: 1.5rem;">
        Bộ truyện: <strong><%= storyTitle %></strong>
    </p>
    
    <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/admin/chapter/edit/<%= chapter.id %>" method="POST">
        <input type="hidden" name="redirect_to" value="<%= redirect_to %>">

        <div style="display: grid; grid-template-columns: 1fr 3fr; gap: 1rem;">
            <div class="form-group">
                <label for="chapter_number">Số Chương *</label>
                <input type="number" id="chapter_number" name="chapter_number" value="<%= chapter.chapter_number %>" step="any" required>
            </div>
            <div class="form-group">
                <label for="title">Tiêu Đề Chương (Tùy chọn)</label>
                <input type="text" id="title" name="title" value="<%= chapter.title %>">
            </div>
        </div>



        <div class="form-group">
            <label>Nội Dung Chương *</label>
            <div class="doc-toolbar">
                <button type="button" data-cmd="undo" title="Hoàn tác (Ctrl+Z)">↶</button>
                <button type="button" data-cmd="redo" title="Làm lại (Ctrl+Y)">↷</button>
                <span class="sep"></span>
                <button type="button" data-cmd="bold" title="Đậm (Ctrl+B)"><b>B</b></button>
                <button type="button" data-cmd="italic" title="Nghiêng (Ctrl+I)"><i>I</i></button>
                <button type="button" data-cmd="underline" title="Gạch chân (Ctrl+U)"><u>U</u></button>
                <span class="sep"></span>
                <button type="button" data-cmd="justifyLeft" title="Căn trái">⯇</button>
                <button type="button" data-cmd="justifyCenter" title="Căn giữa">≡</button>
                <span class="sep"></span>
                <button type="button" id="btn-insert-image" title="Chèn ảnh tại vị trí con trỏ (cũng có thể dán hoặc kéo thả ảnh vào trang)">🖼️ Chèn ảnh</button>
                <input type="file" id="doc-image-input" accept="image/png,image/jpeg,image/webp,image/gif" multiple style="display:none;">
                <span class="sep"></span>
                <select id="doc-zoom" title="Cỡ chữ">
                    <option value="15">Chữ nhỏ</option>
                    <option value="17" selected>Chữ vừa</option>
                    <option value="19">Chữ lớn</option>
                    <option value="22">Chữ rất lớn</option>
                </select>
                <span style="flex:1"></span>
                <button type="button" id="btn-html-mode" title="Xem/sửa mã HTML">&lt;/&gt; HTML</button>
                <span id="doc-count" class="doc-count"></span>
            </div>
            <div class="doc-desk">
                <div id="doc-editor" class="doc-page" contenteditable="true" spellcheck="false"></div>
                <textarea id="content" name="content" class="doc-html" rows="24" style="display:none;"><%= chapter.content %></textarea>
            </div>
        </div>

        <style>
            .doc-toolbar { display:flex; align-items:center; gap:4px; flex-wrap:wrap; padding:6px 8px; background:#f3f4f6; border:1px solid #d1d5db; border-bottom:none; border-radius:8px 8px 0 0; position:sticky; top:0; z-index:5; }
            .doc-toolbar button, .doc-toolbar select { background:#fff; color:#111; border:1px solid #d1d5db; border-radius:4px; padding:4px 10px; font-size:0.9rem; cursor:pointer; min-width:32px; }
            .doc-toolbar button:hover { background:#e5e7eb; }
            .doc-toolbar .sep { width:1px; height:22px; background:#d1d5db; margin:0 4px; }
            .doc-count { color:#6b7280; font-size:0.8rem; margin-left:8px; }
            .doc-desk { background:#d9dce1; border:1px solid #d1d5db; border-radius:0 0 8px 8px; padding:24px 12px; max-height:75vh; overflow:auto; }
            .doc-page { background:#fff; color:#1f2328; width:100%; max-width:794px; min-height:900px; margin:0 auto; padding:64px 72px; box-shadow:0 2px 10px rgba(0,0,0,.25); font-family:'Times New Roman', Cambria, Georgia, serif; font-size:17px; line-height:1.7; outline:none; box-sizing:border-box; text-align:left; }
            .doc-page p { margin:0 0 .9em; text-indent:0; }
            .doc-page img { max-width:100%; height:auto; display:block; margin:12px auto; }
            .doc-page .img-uploading { text-align:center; color:#6b7280; font-style:italic; background:#f3f4f6; border:1px dashed #9ca3af; border-radius:6px; padding:18px; }
            .doc-html { width:100%; box-sizing:border-box; font-family:Consolas, monospace; font-size:13px; line-height:1.5; padding:12px; background:#fff; color:#111; border:none; }
            @media (max-width:700px){ .doc-page{ padding:28px 18px; min-height:600px; } .doc-desk{ padding:10px 4px; } }
        </style>

        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
            <button type="submit" class="btn btn-primary" style="flex: 3; padding: 0.8rem; font-size: 1rem;">CẬP NHẬT CHƯƠNG TRUYỆN</button>
            <button type="button" id="btn-delete-chapter" class="btn btn-secondary" style="flex: 1; padding: 0.8rem; font-size: 1rem; background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); cursor: pointer;">
                🗑️ Xoá Chương
            </button>
        </div>
    </form>

    <!-- Form ẩn phục vụ việc xoá chương -->
    <form id="delete-chapter-form" action="/admin/chapter/delete/<%= chapter.id %>" method="POST" style="display: none;">
        <% 
           let fallbackRedirect = redirect_to;
           if (redirect_to.includes('/chapter/')) {
               fallbackRedirect = `/admin/story/edit/${chapter.story_id}`;
           }
        %>
        <input type="hidden" name="redirect_to" value="<%= fallbackRedirect %>">
    </form>
</div>

<script>
    (function () {
        const form = document.querySelector('form[action^="/admin/chapter/edit/"]');
        const ed = document.getElementById('doc-editor');
        const ta = document.getElementById('content');
        const count = document.getElementById('doc-count');
        let htmlMode = false;

        function toParagraphs(raw) {
            raw = (raw || '').trim();
            if (!/<p[\s>]|<br|<div/i.test(raw)) {
                return raw.split(/\r?\n/).map(l => l.trim()).filter(Boolean).map(l => '<p>' + l + '</p>').join('');
            }
            return raw;
        }
        function serialize() {
            const tmp = document.createElement('div');
            tmp.innerHTML = ed.innerHTML;
            // chuyển <div> cấp 1 và text rời thành <p>
            const out = [];
            tmp.childNodes.forEach(n => {
                if (n.nodeType === 3) { const t = n.textContent.trim(); if (t) out.push('<p>' + t.replace(/&/g,'&amp;').replace(/</g,'&lt;') + '</p>'); }
                else if (n.nodeName === 'DIV') { out.push('<p>' + n.innerHTML.replace(/^<br>$/, '') + '</p>'); }
                else out.push(n.outerHTML);
            });
            return out.filter(h => h !== '<p></p>').join('');
        }
        function updateCount() {
            const t = ed.innerText.trim();
            count.textContent = (t ? t.split(/\s+/).length : 0).toLocaleString('vi-VN') + ' từ';
        }

        ed.innerHTML = toParagraphs(ta.value);
        try { document.execCommand('defaultParagraphSeparator', false, 'p'); } catch (e) {}
        updateCount();
        ed.addEventListener('input', updateCount);

        // dán chỉ lấy chữ thuần, mỗi dòng thành 1 đoạn
        // Chuẩn hoá nội dung dán từ mọi nguồn thành danh sách dòng (mỗi dòng = 1 đoạn)
        function glueSplit(t) {
            return t
                .replace(/([.!?…:])(?=[A-ZÀ-Ỵ—])/g, '$1\n')
                .replace(/([^\s\n>])(?=— )/g, '$1\n')
                .split('\n');
        }
        function pasteToLines(cd) {
            const plain = cd.getData('text/plain') || '';
            let best = plain;
            const html = cd.getData('text/html');
            if (html) {
                try {
                    const d = new DOMParser().parseFromString(html, 'text/html');
                    d.querySelectorAll('script,style').forEach(n => n.remove());
                    d.querySelectorAll('br').forEach(n => n.replaceWith('\n'));
                    d.querySelectorAll('p,div,li,tr,h1,h2,h3,h4,h5,h6,blockquote,section,article').forEach(n => n.append('\n'));
                    const fromHtml = d.body.textContent || '';
                    if (fromHtml.split(/\r?\n/).filter(l => l.trim()).length > best.split(/\r?\n/).filter(l => l.trim()).length) best = fromHtml;
                } catch (err) {}
            }
            const out = [];
            best.split(/\r\n|\r|\n|\u2028|\u2029|\u000b|\u0085/).forEach(l => {
                l = l.replace(/\u00a0/g, ' ').trim();
                if (!l) return;
                glueSplit(l).forEach(x => { x = x.trim(); if (x) out.push(x); });
            });
            return out;
        }

        // ===== CHÈN ẢNH TẠI VỊ TRÍ CON TRỎ (giống chèn ảnh trong Word) =====
        const MAX_IMG_BYTES = 4.3 * 1024 * 1024; // Vercel giới hạn body ~4.5MB
        let savedRange = null;
        document.addEventListener('selectionchange', () => {
            const sel = window.getSelection();
            if (sel.rangeCount && ed.contains(sel.getRangeAt(0).startContainer)) savedRange = sel.getRangeAt(0).cloneRange();
        });

        // Tách đoạn tại con trỏ, chèn 1 đoạn giữ chỗ vào giữa, trả về đoạn giữ chỗ
        function insertPlaceholderAt(range, label) {
            const ph = document.createElement('p');
            ph.className = 'img-uploading';
            ph.contentEditable = 'false';
            ph.textContent = label;
            if (!range || !ed.contains(range.startContainer)) { ed.appendChild(ph); return ph; }
            let blk = range.startContainer;
            if (blk === ed) { ed.insertBefore(ph, ed.childNodes[range.startOffset] || null); return ph; }
            while (blk.parentNode !== ed) blk = blk.parentNode;
            if (blk.nodeType === 3) { const w = document.createElement('p'); ed.insertBefore(w, blk); w.appendChild(blk); blk = w; }
            // phần sau con trỏ chuyển sang đoạn mới nằm dưới ảnh
            const tailRange = document.createRange();
            tailRange.setStart(range.startContainer, range.startOffset);
            tailRange.setEndAfter(blk.lastChild || blk);
            const tail = document.createElement('p');
            tail.appendChild(tailRange.extractContents());
            const headEmpty = !blk.textContent.trim() && !blk.querySelector('img');
            const tailEmpty = !tail.textContent.trim() && !tail.querySelector('img');
            if (headEmpty) { ed.insertBefore(ph, blk); blk.remove(); }
            else ed.insertBefore(ph, blk.nextSibling);
            if (!tailEmpty) ed.insertBefore(tail, ph.nextSibling);
            return ph;
        }

        async function uploadImageFile(file) {
            const fd = new FormData();
            fd.append('image', file);
            const res = await fetch('/admin/api/upload-image', { method: 'POST', body: fd });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.url) throw new Error(data.error || ('Lỗi máy chủ ' + res.status));
            return data.url;
        }

        async function insertImages(files, range) {
            files = [...files].filter(f => /^image\//.test(f.type));
            if (!files.length) return;
            if (htmlMode) { alert('Hãy tắt chế độ HTML trước khi chèn ảnh.'); return; }
            // Tạo sẵn chỗ cho từng ảnh theo đúng thứ tự, rồi mới upload
            let r = range;
            const slots = files.map(f => {
                const ph = insertPlaceholderAt(r, '⏳ Đang tải ảnh "' + f.name + '"...');
                r = document.createRange(); r.setStartAfter(ph); r.collapse(true);
                return { f, ph };
            });
            updateCount();
            for (const { f, ph } of slots) {
                if (f.size > MAX_IMG_BYTES) {
                    ph.remove();
                    alert('Ảnh "' + f.name + '" nặng ' + (f.size / 1048576).toFixed(1) + 'MB, vượt giới hạn 4.3MB. Hãy dùng ảnh nhỏ hơn.');
                    continue;
                }
                try {
                    const url = await uploadImageFile(f);
                    const p = document.createElement('p');
                    p.style.textAlign = 'center';
                    const img = document.createElement('img');
                    img.src = url;
                    img.alt = 'Ảnh minh họa';
                    p.appendChild(img);
                    ph.replaceWith(p);
                } catch (err) {
                    ph.remove();
                    alert('Không tải được ảnh "' + f.name + '": ' + err.message);
                }
            }
            updateCount();
        }

        const imgInput = document.getElementById('doc-image-input');
        const btnImg = document.getElementById('btn-insert-image');
        btnImg.addEventListener('mousedown', e => e.preventDefault()); // giữ nguyên vị trí con trỏ
        btnImg.addEventListener('click', () => {
            if (htmlMode) { alert('Hãy tắt chế độ HTML trước khi chèn ảnh.'); return; }
            if (!savedRange) { alert('Hãy bấm vào chỗ muốn chèn ảnh trong trang trước.'); return; }
            imgInput.click();
        });
        imgInput.addEventListener('change', () => {
            const files = imgInput.files;
            const range = savedRange ? savedRange.cloneRange() : null;
            insertImages(files, range).finally(() => { imgInput.value = ''; });
        });

        // kéo thả ảnh vào trang: chèn tại chỗ thả
        ed.addEventListener('dragover', e => { if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) e.preventDefault(); });
        ed.addEventListener('drop', e => {
            const files = e.dataTransfer && e.dataTransfer.files;
            if (!files || !files.length) return;
            e.preventDefault();
            let range = null;
            if (document.caretRangeFromPoint) range = document.caretRangeFromPoint(e.clientX, e.clientY);
            else if (document.caretPositionFromPoint) { const p = document.caretPositionFromPoint(e.clientX, e.clientY); if (p) { range = document.createRange(); range.setStart(p.offsetNode, p.offset); range.collapse(true); } }
            insertImages(files, range || savedRange);
        });

        // dán: mỗi dòng của văn bản gốc thành 1 đoạn riêng (<p>)
        ed.addEventListener('paste', e => {
            e.preventDefault();
            const cd = e.clipboardData || window.clipboardData;
            // dán ảnh (chụp màn hình, copy ảnh): upload rồi chèn tại con trỏ
            const pastedImgs = cd && cd.files ? [...cd.files].filter(f => /^image\//.test(f.type)) : [];
            if (pastedImgs.length) {
                const sel0 = window.getSelection();
                insertImages(pastedImgs, sel0.rangeCount ? sel0.getRangeAt(0).cloneRange() : savedRange);
                return;
            }
            const lines = pasteToLines(cd);
            if (!lines.length) return;
            const sel = window.getSelection();
            if (!sel.rangeCount) return;
            if (!sel.isCollapsed) document.execCommand('delete');
            if (!sel.rangeCount) return;
            const range = sel.getRangeAt(0);
            let blk = range.startContainer;
            if (blk === ed) { const p0 = document.createElement('p'); p0.appendChild(document.createElement('br')); ed.insertBefore(p0, ed.childNodes[range.startOffset] || null); blk = p0; range.setStart(p0, 0); range.collapse(true); }
            while (blk.parentNode !== ed) blk = blk.parentNode;
            if (blk.nodeType === 3) { const w = document.createElement('p'); ed.insertBefore(w, blk); w.appendChild(blk); blk = w; }
            // tách phần sau con trỏ sang đoạn mới
            const tailRange = document.createRange();
            tailRange.setStart(range.startContainer, range.startOffset);
            tailRange.setEndAfter(blk.lastChild || blk);
            const tail = document.createElement(blk.nodeName === 'P' ? 'p' : 'p');
            tail.appendChild(tailRange.extractContents());
            const mk = txt => { const p = document.createElement('p'); p.textContent = txt; return p; };
            // dòng đầu nối vào đoạn hiện tại, các dòng giữa là đoạn mới, dòng cuối nối vào phần đuôi
            const first = lines.shift();
            if (blk.firstChild && blk.firstChild.nodeName === 'BR' && blk.childNodes.length === 1) blk.textContent = '';
            blk.appendChild(document.createTextNode(first));
            let ref = blk;
            let lastP = blk;
            lines.forEach(l => { const p = mk(l); ed.insertBefore(p, ref.nextSibling); ref = p; lastP = p; });
            const hasTail = tail.textContent.trim() !== '' || tail.querySelector('img');
            const tailCount = hasTail ? tail.childNodes.length : 0;
            const before = lastP.childNodes.length;
            if (hasTail) { while (tail.firstChild) lastP.appendChild(tail.firstChild); }
            // đặt con trỏ ngay sau phần vừa dán
            const r2 = document.createRange();
            r2.setStart(lastP, before);
            r2.collapse(true);
            sel.removeAllRanges(); sel.addRange(r2);
            updateCount();
        });

        document.querySelectorAll('.doc-toolbar [data-cmd]').forEach(b => {
            b.addEventListener('mousedown', e => e.preventDefault());
            b.addEventListener('click', () => { ed.focus(); document.execCommand(b.dataset.cmd, false, null); updateCount(); });
        });
        document.getElementById('doc-zoom').addEventListener('change', e => { ed.style.fontSize = e.target.value + 'px'; });

        document.getElementById('btn-html-mode').addEventListener('click', () => {
            htmlMode = !htmlMode;
            if (htmlMode) { ta.value = serialize().replace(/<\/p>/g, '</p>\n'); ed.style.display = 'none'; ta.style.display = 'block'; }
            else { ed.innerHTML = toParagraphs(ta.value); ta.style.display = 'none'; ed.style.display = 'block'; updateCount(); }
        });

        form.addEventListener('submit', e => {
            if (ed.querySelector('.img-uploading')) { e.preventDefault(); alert('Ảnh đang được tải lên, vui lòng đợi xong rồi hãy lưu.'); return; }
            if (!htmlMode) ta.value = serialize();
        });
    })();

    const btnDelete = document.getElementById('btn-delete-chapter');
    if (btnDelete) {
        btnDelete.addEventListener('click', () => {
            if (confirm('Bạn có chắc chắn muốn XÓA chương này không? Hành động này không thể hoàn tác!')) {
                document.getElementById('delete-chapter-form').submit();
            }
        });
    }
</script>

<%- include('../partials/footer') %>
