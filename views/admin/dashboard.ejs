<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title" style="margin-bottom: 0;">🛠️ Bảng Điều Khiển Quản Trị</h1>
    <div style="display: flex; flex-wrap: wrap; gap: 0.8rem;">
        <a href="/admin/story/add" class="btn btn-primary">➕ Đăng bộ truyện mới</a>
        <a href="/admin/chapter/add" class="btn btn-secondary">⚡ Đăng chương truyện</a>
        <a href="/admin/genres" class="btn btn-secondary">🏷️ Thể loại</a>
        <a href="/admin/banners" class="btn btn-secondary">📺 Quản lý Banner</a>
        <a href="/admin/requests" class="btn btn-secondary" style="background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.3); color: #f59e0b;">💬 Yêu cầu độc giả</a>
        <a href="/admin/comments" class="btn btn-secondary" style="background: rgba(139, 92, 246, 0.1); border-color: rgba(139, 92, 246, 0.3); color: #a78bfa;">💬 Bình luận & User</a>
        <a href="/admin/ranks" class="btn btn-secondary" style="background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.3); color: #10b981;">🏆 Thiết lập Rank cấp bậc</a>
        <a href="/admin/shop" class="btn btn-secondary" style="background: rgba(236, 72, 153, 0.1); border-color: rgba(236, 72, 153, 0.3); color: #ec4899;">🛒 Quản lý Cửa hàng EXP</a>
        <a href="/admin/heroes" class="btn btn-secondary" style="background: rgba(236, 72, 153, 0.15); border-color: rgba(236, 72, 153, 0.35); color: #f472b6; font-weight: 600;">👑 Quản lý Nữ Tướng</a>
        <button type="button" id="btn-open-sync-modal" class="btn" style="background: linear-gradient(135deg, #059669, #10b981); color: #fff; font-weight: 600; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35); border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
            🔄 Cập nhật chap mới (Link ngoài)
        </button>
        <button type="button" id="btn-check-supabase-images" class="btn btn-secondary" style="background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.35); color: #60a5fa; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
            🦆 Phục hồi ảnh Supabase cũ
        </button>
    </div>
</div>

<!-- Khối hiển thị số liệu thống kê nhanh -->
<div class="admin-stats">
    <div class="stat-card">
        <span class="stat-value"><%= stats.stories %></span>
        <span class="stat-label">Truyện đã đăng</span>
    </div>
    <div class="stat-card">
        <span class="stat-value"><%= stats.chapters %></span>
        <span class="stat-label">Tổng số chương</span>
    </div>
    <div class="stat-card">
        <span class="stat-value"><%= stats.views %></span>
        <span class="stat-label">Tổng lượt đọc truyện</span>
    </div>
    <div class="stat-card">
        <span class="stat-value" style="color: #60a5fa;"><%= stats.users %></span>
        <span class="stat-label">Tổng số thành viên</span>
    </div>
    <div class="stat-card">
        <span class="stat-value" style="color: #10b981;">+<%= stats.newUsersMonth %></span>
        <span class="stat-label">Thành viên mới (Tháng <%= stats.currentMonth %>)</span>
    </div>
    <div class="stat-card">
        <span class="stat-value"><%= stats.requests %></span>
        <span class="stat-label">Yêu cầu từ độc giả</span>
    </div>
</div>

<!-- Danh sách truyện đã đăng -->
<div class="admin-box" style="margin-top: 2rem;">
    <h2 class="section-title" style="font-size: 1.4rem; margin-bottom: 0.5rem;">Danh Sách Các Bộ Truyện</h2>
    
    <!-- Ô tìm kiếm truyện trong admin -->
    <div style="margin-bottom: 1.5rem; max-width: 450px;">
        <input type="text" id="admin-story-search" placeholder="🔍 Gõ từ khóa tìm nhanh truyện (tên, tác giả, người đặt)..." 
            style="width: 100%; padding: 0.7rem 1rem; background: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 8px; font-size: 0.9rem; outline: none; box-sizing: border-box;">
    </div>
    
    <% if (stories.length === 0) { %>
        <p style="color: var(--text-secondary); text-align: center; padding: 2rem 0;">Chưa có bộ truyện nào được tạo. Hãy bấm vào "Đăng bộ truyện mới" để bắt đầu.</p>
    <% } else { %>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Bìa</th>
                    <th>Tên Truyện</th>
                    <th>Tác Giả</th>
                    <th>Người Đặt</th>
                    <th>Ngày Đăng</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                <% stories.forEach(story => { %>
                    <tr>
                        <td>
                            <img src="<%= story.cover_url %>" alt="Cover" style="width: 40px; height: 50px; object-fit: cover; border-radius: 4px;" onerror="this.onerror=null; this.src='/css/default-cover.jpg';">
                        </td>
                        <td>
                            <strong><%= story.title %></strong>
                        </td>
                        <td><%= story.author %></td>
                        <td>
                            <% if (story.commissioned_by) { %>
                                <span style="font-size: 0.85rem; color: #10b981; background: rgba(16, 185, 129, 0.1); padding: 0.2rem 0.5rem; border-radius: 4px;"><%= story.commissioned_by %></span>
                            <% } else { %>
                                <span style="color: var(--text-secondary); font-size: 0.85rem;">-</span>
                            <% } %>
                        </td>
                        <td><%= new Date(story.created_at).toLocaleDateString('vi-VN') %></td>
                        <td>
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <a href="/story/<%= story.id %>" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;" target="_blank">Xem</a>
                                <a href="/admin/story/edit/<%= story.id %>" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; background: rgba(59, 130, 246, 0.1); border-color: rgba(59, 130, 246, 0.2); color: var(--accent-color);">Sửa</a>
                                <a href="/admin/story/download-epub/<%= story.id %>" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2); color: #10b981;">Tải EPUB</a>
                                <% if (user && (user.role === 'admin' || user.role === 'sp_admin')) { %>
                                <form action="/admin/story/delete/<%= story.id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bộ truyện này không? Tất cả các chương truyện, lượt đọc và thể loại liên kết của bộ truyện này sẽ bị xóa vĩnh viễn!');" style="display: inline; margin: 0;">
                                    <button type="submit" class="btn btn-danger" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; border-radius: 4px;">Xóa</button>
                                </form>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

<script>
    const searchInput = document.getElementById('admin-story-search');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
            const rows = document.querySelectorAll('.admin-table tbody tr');
            
            rows.forEach(row => {
                const titleCell = row.querySelector('td:nth-child(2)');
                const authorCell = row.querySelector('td:nth-child(3)');
                const commissionedCell = row.querySelector('td:nth-child(4)');
                
                const title = titleCell ? titleCell.textContent.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : '';
                const author = authorCell ? authorCell.textContent.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : '';
                const commissioned = commissionedCell ? commissionedCell.textContent.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : '';
                
                if (title.includes(query) || author.includes(query) || commissioned.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    }

    // ==========================================
    // MODAL & TIẾN TRÌNH CẬP NHẬT TRUYỆN TỪ NGUỒN NGOÀI
    // ==========================================
    const syncModal = document.getElementById('sync-external-modal');
    const btnOpenSync = document.getElementById('btn-open-sync-modal');
    const btnCloseSync = document.getElementById('btn-close-sync-modal');
    const btnStartSync = document.getElementById('btn-start-sync');
    const btnSyncBg = document.getElementById('btn-sync-bg');
    const syncLogBox = document.getElementById('sync-log-box');
    const syncProgressBar = document.getElementById('sync-progress-bar-fill');
    const syncPercentText = document.getElementById('sync-percent-text');
    const syncStatusText = document.getElementById('sync-status-text');

    if (btnOpenSync && syncModal) {
        btnOpenSync.addEventListener('click', () => {
            syncModal.style.display = 'flex';
        });
    }

    if (btnCloseSync && syncModal) {
        btnCloseSync.addEventListener('click', () => {
            syncModal.style.display = 'none';
        });
    }

    // Chạy ngầm trong nền
    if (btnSyncBg) {
        btnSyncBg.addEventListener('click', async () => {
            if (!confirm('Hệ thống sẽ chạy quét ngầm toàn bộ truyện có link nguồn trong nền trên máy chủ. Bạn có muốn tiếp tục?')) return;
            try {
                btnSyncBg.disabled = true;
                btnSyncBg.textContent = '⏳ Đang kích hoạt...';
                const resp = await fetch('/admin/api/sync-all-background', { method: 'POST' });
                const data = await resp.json();
                alert(data.message || 'Đã kích hoạt quét trong nền.');
                if (syncModal) syncModal.style.display = 'none';
            } catch (err) {
                alert('Lỗi kích hoạt: ' + err.message);
            } finally {
                btnSyncBg.disabled = false;
                btnSyncBg.textContent = '⚡ Chạy ngầm trong nền';
            }
        });
    }

    function appendSyncLog(msg, color = '#e2e8f0') {
        if (!syncLogBox) return;
        const line = document.createElement('div');
        line.style.color = color;
        line.style.fontSize = '0.84rem';
        line.style.lineHeight = '1.45';
        line.style.marginBottom = '4px';
        line.innerHTML = `[${new Date().toLocaleTimeString('vi-VN')}] ${msg}`;
        syncLogBox.appendChild(line);
        syncLogBox.scrollTop = syncLogBox.scrollHeight;
    }

    // Bắt đầu cập nhật trực quan
    if (btnStartSync) {
        btnStartSync.addEventListener('click', async () => {
            const mode = document.querySelector('input[name="sync_mode"]:checked')?.value || 'recent';
            btnStartSync.disabled = true;
            btnStartSync.innerHTML = '⏳ Đang quét & cập nhật...';
            syncLogBox.innerHTML = '';
            syncProgressBar.style.width = '0%';
            syncPercentText.textContent = '0%';
            syncStatusText.textContent = 'Đang khởi động tiến trình...';

            let totalNewChapters = 0;

            if (mode === 'recent') {
                const pages = parseInt(document.getElementById('sync-recent-pages')?.value) || 3;
                appendSyncLog(`🚀 Bắt đầu quét nhanh ${pages} trang mới nhất từ nguồn ngoài...`, '#60a5fa');
                syncProgressBar.style.width = '30%';
                syncPercentText.textContent = '30%';
                try {
                    const resp = await fetch('/admin/api/sync-recent-donghentai', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ pages })
                    });
                    const resJson = await resp.json();
                    if (resJson.success) {
                        syncProgressBar.style.width = '100%';
                        syncPercentText.textContent = '100%';
                        appendSyncLog(`✅ ${resJson.message}`, '#10b981');
                        syncStatusText.textContent = 'Hoàn tất quét nhanh!';
                        setTimeout(() => alert('🎉 Cập nhật thành công các chương mới nhất từ nguồn ngoài!'), 600);
                    } else {
                        throw new Error(resJson.error || 'Lỗi không xác định.');
                    }
                } catch (err) {
                    appendSyncLog(`❌ Lỗi: ${err.message}`, '#ef4444');
                    syncStatusText.textContent = 'Có lỗi xảy ra.';
                } finally {
                    btnStartSync.disabled = false;
                    btnStartSync.innerHTML = '▶️ Bắt Đầu Cập Nhật';
                }
            } else {
                // Quét từng truyện trong DB
                appendSyncLog('📡 Đang tải danh sách các truyện có link nguồn từ máy chủ...', '#60a5fa');
                try {
                    const listResp = await fetch('/admin/api/sync-stories-list');
                    const listData = await listResp.json();
                    if (!listData.success || !listData.stories) {
                        throw new Error(listData.error || 'Không tải được danh sách truyện.');
                    }
                    const stories = listData.stories;
                    appendSyncLog(`📋 Tìm thấy ${stories.length} bộ truyện có link nguồn. Đang tiến hành quét tuần tự...`, '#a78bfa');

                    for (let i = 0; i < stories.length; i++) {
                        const s = stories[i];
                        const progress = Math.round(((i + 1) / stories.length) * 100);
                        syncProgressBar.style.width = `${progress}%`;
                        syncPercentText.textContent = `${progress}%`;
                        syncStatusText.textContent = `Đang quét (${i + 1}/${stories.length}): ${s.title}`;
                        appendSyncLog(`🔄 [${i + 1}/${stories.length}] Đang kiểm tra: <strong>${s.title}</strong>...`, '#94a3b8');

                        try {
                            const crawlResp = await fetch(`/admin/api/sync-single-story/${s.id}`, { method: 'POST' });
                            const crawlData = await crawlResp.json();
                            if (crawlData.success && crawlData.addedCount > 0) {
                                totalNewChapters += crawlData.addedCount;
                                appendSyncLog(`✨ +${crawlData.addedCount} chương mới đã thêm cho "${s.title}"!`, '#10b981');
                            } else if (crawlData.success) {
                                appendSyncLog(`✓ Đã là chương mới nhất`, '#64748b');
                            } else {
                                appendSyncLog(`⚠️ Lỗi quét "${s.title}": ${crawlData.error || 'Nguồn bận'}`, '#f59e0b');
                            }
                        } catch (sErr) {
                            appendSyncLog(`⚠️ Ngoại lệ "${s.title}": ${sErr.message}`, '#f59e0b');
                        }

                        // Nghỉ nhẹ 400ms giữa các truyện để tránh nghẽn
                        await new Promise(r => setTimeout(r, 400));
                    }

                    appendSyncLog(`🏁 HOÀN TẤT! Tổng cộng đã thêm ${totalNewChapters} chương mới!`, '#10b981');
                    syncStatusText.textContent = `Hoàn tất! Đã thêm ${totalNewChapters} chương mới.`;
                    setTimeout(() => alert(`🎉 Quét hoàn tất! Đã cập nhật thành công tổng cộng ${totalNewChapters} chương mới cho các bộ truyện.`), 600);
                } catch (err) {
                    appendSyncLog(`❌ Lỗi hệ thống: ${err.message}`, '#ef4444');
                    syncStatusText.textContent = 'Gặp lỗi trong quá trình quét.';
                } finally {
                    btnStartSync.disabled = false;
                    btnStartSync.innerHTML = '▶️ Bắt Đầu Cập Nhật';
                }
            }
        });
    }

    // ==========================================
    // NÚT PHỤC HỒI ẢNH TỪ SUPABASE CŨ SANG MỚI
    // ==========================================
    const btnCheckSupabase = document.getElementById('btn-check-supabase-images');
    if (btnCheckSupabase) {
        btnCheckSupabase.addEventListener('click', async () => {
            btnCheckSupabase.disabled = true;
            btnCheckSupabase.innerHTML = '⏳ Đang kiểm tra Supabase cũ...';
            try {
                const resp = await fetch('/admin/api/check-migrate-images', { method: 'POST' });
                const data = await resp.json();
                if (data.unlocked) {
                    alert(`🎉 SUPABASE CŨ ĐÃ MỞ LẠI VÀ DI CHUYỂN THÀNH CÔNG!\n- Bìa truyện đã phục hồi: ${data.migratedStories}\n- Avatar thành viên đã phục hồi: ${data.migratedUsers}\n- Banners: ${data.migratedBanners}\n- Nữ tướng: ${data.migratedHeroes}\nTrang sẽ tải lại ngay để cập nhật ảnh.`);
                    location.reload();
                } else {
                    alert(`ℹ️ THÔNG BÁO TỪ SUPABASE CŨ:\n\n${data.message || 'Supabase cũ hiện vẫn đang hạn chế băng thông (HTTP 402).'}\n\n👉 Bạn yên tâm: Hệ thống đã bật chế độ tự động theo dõi trong nền. Ngay thời khắc Supabase cũ mở khóa, toàn bộ ảnh bìa và avatar sẽ lập tức được tự động kéo về Supabase mới 100%!`);
                }
            } catch (err) {
                alert('Lỗi kiểm tra Supabase: ' + err.message);
            } finally {
                btnCheckSupabase.disabled = false;
                btnCheckSupabase.innerHTML = '🦆 Phục hồi ảnh Supabase cũ';
            }
        });
    }
</script>

<!-- MODAL CẬP NHẬT TRUYỆN TỰ ĐỘNG TỪ NGUỒN NGOÀI -->
<div id="sync-external-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(6px); z-index: 99999; justify-content: center; align-items: center; padding: 1rem; box-sizing: border-box;">
    <div style="background: var(--bg-secondary, #1e293b); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); border-radius: 16px; max-width: 650px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
        <!-- Header -->
        <div style="padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1)); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.25rem; display: flex; align-items: center; gap: 0.5rem; color: #fff;">
                <span>🔄</span> Cập Nhật Chương Mới Tự Động (Link Nguồn Ngoài)
            </h3>
            <button type="button" id="btn-close-sync-modal" style="background: none; border: none; font-size: 1.5rem; color: #94a3b8; cursor: pointer; line-height: 1;">&times;</button>
        </div>

        <!-- Body -->
        <div style="padding: 1.5rem; overflow-y: auto; flex: 1;">
            <p style="color: var(--text-secondary, #94a3b8); font-size: 0.9rem; margin: 0 0 1.2rem 0; line-height: 1.5;">
                Hệ thống sẽ tự động đối chiếu các link nguồn (DongHentai, VietManhwa, TruyenMoiSS, NetTruyen...) để tìm các chương mới nhất chưa có trong cơ sở dữ liệu và tải về cho độc giả.
            </p>

            <!-- Tùy chọn chế độ quét -->
            <div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 1.2rem; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: flex-start; gap: 0.8rem; cursor: pointer; margin-bottom: 1rem;">
                    <input type="radio" name="sync_mode" value="recent" checked style="margin-top: 3px; accent-color: #10b981;">
                    <div>
                        <strong style="color: #fff; font-size: 0.95rem;">⚡ Chế độ 1: Quét nhanh truyện mới ra chương (Khuyên dùng)</strong>
                        <div style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.2rem;">
                            Quét 
                            <input type="number" id="sync-recent-pages" value="3" min="1" max="10" style="width: 45px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); color: #fff; border-radius: 4px; padding: 2px 5px; text-align: center;" onclick="event.stopPropagation()">
                            trang cập nhật mới nhất từ nguồn ngoài. Cực nhanh, lấy đúng các truyện vừa có chap mới.
                        </div>
                    </div>
                </label>

                <label style="display: flex; align-items: flex-start; gap: 0.8rem; cursor: pointer;">
                    <input type="radio" name="sync_mode" value="all" style="margin-top: 3px; accent-color: #10b981;">
                    <div>
                        <strong style="color: #fff; font-size: 0.95rem;">🌐 Chế độ 2: Quét toàn diện tất cả các truyện có link nguồn</strong>
                        <div style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.2rem;">
                            Rà soát tuần tự từng bộ truyện trong 75+ bộ có link nguồn để đảm bảo không bỏ sót bất kỳ chương nào.
                        </div>
                    </div>
                </label>
            </div>

            <!-- Thanh tiến trình -->
            <div style="margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.4rem;">
                    <span id="sync-status-text" style="color: #94a3b8;">Sẵn sàng bắt đầu...</span>
                    <span id="sync-percent-text" style="color: #10b981; font-weight: bold;">0%</span>
                </div>
                <div style="width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden;">
                    <div id="sync-progress-bar-fill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #10b981, #3b82f6); transition: width 0.3s ease;"></div>
                </div>
            </div>

            <!-- Khung Log tiến trình -->
            <div id="sync-log-box" style="background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.8rem; height: 160px; overflow-y: auto; font-family: monospace; box-sizing: border-box;">
                <div style="color: #64748b; font-size: 0.82rem;">Bấm "Bắt Đầu Cập Nhật" để theo dõi tiến trình trực tiếp tại đây...</div>
            </div>
        </div>

