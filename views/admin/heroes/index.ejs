<%- include('../../partials/header') %>

<div style="max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="section-title" style="margin-bottom: 0.3rem;">👑 Quản Lý Nữ Tướng (Waifu Cards)</h1>
            <p style="color: var(--text-secondary); font-size: 0.9rem; margin: 0;">Danh sách toàn bộ nữ tướng trong game thẻ bài Đấu Trường.</p>
        </div>
        <div style="display: flex; gap: 0.8rem; flex-wrap: wrap;">
            <a href="/admin/heroes/create" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.2rem; font-weight: 600;">
                ✨ Tạo Nữ Tướng Mới
            </a>
            <a href="/admin" class="btn btn-secondary" style="padding: 0.6rem 1rem;">
                Quay lại Admin
            </a>
            <a href="/arena" target="_blank" class="btn btn-secondary" style="background: rgba(236, 72, 153, 0.15); border-color: rgba(236, 72, 153, 0.4); color: #ec4899; font-weight: 600;">
                ⚔️ Thử Sàn Đấu
            </a>
        </div>
    </div>

    <% if (heroes.length === 0) { %>
        <div style="text-align: center; padding: 3rem 1rem; background: var(--bg-secondary); border-radius: 12px; border: 1px solid var(--border-color);">
            <p style="color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 1rem;">Chưa có nữ tướng nào trong hệ thống.</p>
            <a href="/admin/heroes/create" class="btn btn-primary">Tạo Nữ Tướng Đầu Tiên</a>
        </div>
    <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
            <% heroes.forEach(hero => { %>
                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.borderColor='var(--accent-color)';" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='var(--border-color)';">
                    <!-- Ảnh bìa thẻ bài -->
                    <div style="position: relative; width: 100%; height: 260px; overflow: hidden; background: #0b0f19;">
                        <img src="<%= hero.card_image_url || hero.avatar_url || '/css/silly_duck.png' %>" alt="<%= hero.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                        <!-- Phẩm chất badge -->
                        <span style="position: absolute; top: 10px; left: 10px; font-weight: 800; font-size: 0.85rem; padding: 0.25rem 0.6rem; border-radius: 6px; text-transform: uppercase;
                            <%= hero.rarity === 'UR' ? 'background: linear-gradient(135deg, #ef4444, #f59e0b); color: white;' : '' %>
                            <%= hero.rarity === 'SSR' ? 'background: linear-gradient(135deg, #f59e0b, #eab308); color: black;' : '' %>
                            <%= hero.rarity === 'SR' ? 'background: linear-gradient(135deg, #8b5cf6, #ec4899); color: white;' : '' %>
                            <%= hero.rarity === 'R' ? 'background: #3b82f6; color: white;' : '' %>
                        ">
                            <%= hero.rarity %>
                        </span>
                        <!-- Hệ nguyên tố -->
                        <span style="position: absolute; top: 10px; right: 10px; font-size: 0.8rem; background: rgba(0,0,0,0.6); padding: 0.2rem 0.5rem; border-radius: 20px; color: white; backdrop-filter: blur(4px);">
                            <% if (hero.element === 'fire') { %>🔥 Hỏa<% } %>
                            <% if (hero.element === 'water') { %>💧 Thủy<% } %>
                            <% if (hero.element === 'wind') { %>🌪️ Phong<% } %>
                            <% if (hero.element === 'thunder') { %>⚡ Lôi<% } %>
                            <% if (hero.element === 'dark') { %>🌑 Ám<% } %>
                            <% if (hero.element === 'light') { %>☀️ Quang<% } %>
                        </span>
                    </div>

                    <div style="padding: 1.2rem; display: flex; flex-direction: column; flex: 1;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.4rem;">
                            <div>
                                <h3 style="margin: 0; font-size: 1.15rem; color: var(--text-primary);"><%= hero.name %></h3>
                                <div style="font-size: 0.82rem; color: #f59e0b; margin-top: 2px;"><%= hero.title || 'Nữ Thần' %></div>
                            </div>
                            <span style="font-size: 0.75rem; background: rgba(255,255,255,0.06); padding: 0.2rem 0.5rem; border-radius: 4px; color: var(--text-secondary);">
                                ID: <%= hero.id %>
                            </span>
                        </div>

                        <!-- Chỉ số cơ bản -->
                        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.4rem; background: rgba(0,0,0,0.25); padding: 0.6rem; border-radius: 8px; margin: 0.6rem 0; font-size: 0.8rem;">
                            <div>❤️ HP: <strong><%= hero.base_hp %></strong></div>
                            <div>⚔️ ATK: <strong><%= hero.base_atk %></strong></div>
                            <div>🛡️ DEF: <strong><%= hero.base_def %></strong></div>
                            <div>👟 SPD: <strong><%= hero.base_spd %></strong></div>
                        </div>

                        <!-- Kỹ năng -->
                        <div style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.8rem;">
                            <div>💥 <strong><%= hero.skill_basic?.name || 'Đánh thường' %></strong>: <%= (hero.skill_basic?.desc || '').substring(0, 50) %>...</div>
                            <div style="margin-top: 3px; color: #ec4899;">🔥 <strong><%= hero.skill_ultimate?.name || 'Tuyệt kỹ' %></strong>: <%= (hero.skill_ultimate?.desc || '').substring(0, 50) %>...</div>
                        </div>

                        <!-- Nút thao tác -->
                        <div style="margin-top: auto; display: flex; gap: 0.5rem; padding-top: 0.8rem; border-top: 1px solid rgba(255,255,255,0.06);">
                            <a href="/admin/heroes/edit/<%= hero.id %>" class="btn btn-secondary" style="flex: 1; text-align: center; padding: 0.4rem; font-size: 0.82rem;">✏️ Sửa</a>
                            <form action="/admin/heroes/delete/<%= hero.id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nữ tướng <%= hero.name %>?');" style="margin: 0;">
                                <button type="submit" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3); color: #ef4444; padding: 0.4rem 0.8rem; font-size: 0.82rem;">🗑️ Xóa</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('../../partials/footer') %>
