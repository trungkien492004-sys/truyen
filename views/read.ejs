<%- include('partials/header') %>

<div class="read-container <%= (typeof story !== 'undefined' && story && story.story_type === 'comic') ? 'read-container--comic' : '' %>">
    <div style="margin-bottom: 2rem;">
        <a href="/story/<%= story.id %>" style="color: var(--text-secondary); font-size: 0.9rem;">&larr; Quay lại trang chi tiết truyện</a>
    </div>

    <div class="read-header" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
        <div>
            <h1 class="read-title" style="margin: 0 0 0.5rem 0;">
                <% if (chapter.title && chapter.title.toLowerCase().startsWith('chương')) { %>
                    <%= chapter.title %>
                <% } else { %>
                    Chương <%= chapter.chapter_number %><% if (chapter.title) { %>: <%= chapter.title %><% } %>
                <% } %>
            </h1>
            <p style="color: var(--text-secondary); font-size: 0.95rem; margin: 0; display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;">
                <span>Truyện: <strong><%= story.title %></strong></span>
                <span style="display: inline-flex; align-items: center; gap: 0.3rem; color: var(--text-secondary); font-size: 0.85rem;" title="Lượt xem chương này">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.7;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <%= chapter.views || 0 %> lượt xem
                </span>
            </p>
        </div>
        <% if (user && (user.role === 'admin' || user.role === 'sp_admin')) { %>
            <a href="/admin/chapter/edit/<%= chapter.id %>?redirect_to=/story/<%= story.id %>/chapter/<%= chapter.chapter_number %>" class="btn btn-secondary" style="border: 1px solid var(--accent-color); color: var(--accent-color); font-size: 0.85rem; padding: 0.4rem 0.8rem; border-radius: 6px; white-space: nowrap; font-weight: 500;">
                ✏️ Sửa Chương
            </a>
        <% } %>
    </div>

    <!-- Thanh chuyển hướng chương trên -->
    <div class="read-navigation" style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <% if (hasPrev) { %>
            <a href="/story/<%= story.id %>/chapter/<%= prevChapterNum %>" class="btn btn-secondary">&larr; Trước</a>
        <% } else { %>
            <button class="btn btn-secondary" style="opacity: 0.5; cursor: not-allowed;" disabled>&larr; Trước</button>
        <% } %>
        
        <!-- Mục lục nhanh dạng trượt (Scrollable Dropdown) -->
        <div class="toc-dropdown" style="position: relative; display: inline-block;">
            <button class="btn btn-secondary toc-toggle-btn" style="display: flex; align-items: center; gap: 0.3rem;">
                📖 Mục lục (C. <%= chapter.chapter_number %>) ▾
            </button>
            <div class="toc-dropdown-content" style="display: none; position: absolute; left: 50%; transform: translateX(-50%); top: 100%; margin-top: 0.5rem; background: var(--bg-secondary); min-width: 280px; max-height: 400px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.6); z-index: 1000; padding: 0.4rem;">
                <div style="position: sticky; top: 0; background: var(--bg-secondary); padding: 0.4rem 0.4rem 0.6rem 0.4rem; z-index: 1;">
                    <input type="text" class="toc-search-input" placeholder="Tìm chương (ví dụ: 15, tên chương)..." style="width: 100%; padding: 0.5rem 0.7rem; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-primary); font-size: 0.85rem; outline: none;" onclick="event.stopPropagation()">
                </div>
                <div class="toc-search-results">
                    <div style="padding-top: 0.3rem;">
                        <% chaptersList.forEach(c => { %>
                            <% const isActive = c.chapter_number === chapter.chapter_number; %>
                            <a href="/story/<%= story.id %>/chapter/<%= c.chapter_number %>" data-search="<%= c.chapter_number %> <%= (c.title || '').toLowerCase() %>" style="display: block; padding: 0.5rem 1.2rem; color: <%= isActive ? 'var(--accent-color)' : 'var(--text-primary)' %>; font-size: 0.88rem; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.02); font-weight: <%= isActive ? 'bold' : 'normal' %>; transition: background 0.2s;" class="toc-item <%= isActive ? 'toc-item-active' : '' %>">
                                <% if (c.title && c.title.toLowerCase().startsWith('chương')) { %>
                                    <%= c.title %>
                                <% } else { %>
                                    Chương <%= c.chapter_number %><% if (c.title) { %>: <%= c.title %><% } %>
                                <% } %>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <% if (hasNext) { %>
            <a href="/story/<%= story.id %>/chapter/<%= nextChapterNum %>" class="btn btn-primary">Tiếp &rarr;</a>
        <% } else { %>
            <button class="btn btn-primary" style="opacity: 0.5; cursor: not-allowed;" disabled>Tiếp &rarr;</button>
        <% } %>
    </div>

    <% if (typeof story === 'undefined' || !story || story.story_type !== 'comic') { %>
    <!-- TRÌNH PHÁT AUDIO TRUYỆN AI (TEXT-TO-SPEECH) -->
    <div class="audio-player-card" id="ai-audio-player">
        <div class="audio-player-header">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="font-size: 1.3rem;">🎧</span>
                <div>
                    <div style="font-weight: 700; font-size: 0.95rem; color: #fff; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <span>Giọng Đọc Audio AI</span>
                        <span style="font-size: 0.65rem; font-weight: 700; background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 0.12rem 0.45rem; border-radius: 4px; text-transform: uppercase;">Miễn Phí · 0MB Data</span>
                    </div>
                    <div id="audio-status-text" style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 2px;">
                        Bấm "Nghe Truyện" để AI đọc chương này
                    </div>
                </div>
            </div>
            <div style="font-size: 0.8rem; color: #a855f7; font-weight: 600;" id="audio-progress-text">
                0/0 (0%)
            </div>
        </div>

        <!-- Thanh tiến trình đọc audio -->
        <div class="audio-progress-bar-wrap" id="audio-progress-wrap" title="Bấm vào thanh để tua đoạn đọc">
            <div class="audio-progress-bar-fill" id="audio-progress-fill"></div>
        </div>

        <!-- Cụm điều khiển -->
        <div class="audio-controls-row">
            <button id="audio-btn-play" class="audio-btn audio-btn-primary">
                ▶ Nghe Truyện
            </button>
            <button id="audio-btn-stop" class="audio-btn" title="Dừng đọc">
                ⏹ Dừng
            </button>
            <div style="display: flex; gap: 0.25rem;">
                <button id="audio-btn-prev" class="audio-btn" title="Đoạn trước">
                    ⏮
                </button>
                <button id="audio-btn-next" class="audio-btn" title="Đoạn tiếp">
                    ⏭
                </button>
            </div>

            <!-- Tốc độ đọc -->
            <div style="display: flex; align-items: center; gap: 0.3rem;">
                <label for="audio-select-rate" style="font-size: 0.76rem; color: var(--text-secondary);">Tốc độ:</label>
                <select id="audio-select-rate" class="audio-select">
                    <option value="0.8">0.8x</option>
                    <option value="1.0" selected>1.0x</option>
                    <option value="1.2">1.2x</option>
                    <option value="1.4">1.4x</option>
                </select>
            </div>

            <!-- Giọng đọc -->
            <div style="display: flex; align-items: center; gap: 0.3rem;">
                <label for="audio-select-voice" style="font-size: 0.76rem; color: var(--text-secondary);">Giọng:</label>
                <select id="audio-select-voice" class="audio-select" style="max-width: 150px;">
                    <option value="">Tự động</option>
                </select>
            </div>

            <!-- Tự chuyển chương -->
            <label style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.76rem; color: var(--text-secondary); cursor: pointer; user-select: none;">
                <input type="checkbox" id="audio-check-autonext" checked style="accent-color: #a855f7;">
                Tự qua chương
            </label>
        </div>
    </div>
    <% } %>

    <!-- Nội dung chương truyện (Có thể chứa cả chữ và các thẻ ảnh đan xen) -->
    <div class="read-content <%= (chapter && chapter.content && /<p\b/i.test(chapter.content)) ? 'has-p-tags' : '' %>" id="chapter-content">
        <%- chapter.content %>
    </div>

    <!-- Đếm số từ - hiển thị góc trái dưới -->
    <div id="word-count-badge" style="display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1.2rem; padding: 0.45rem 0.9rem; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 20px; font-size: 0.82rem; color: var(--text-secondary); font-weight: 500;">
        📖 <span id="word-count-num">...</span> từ
    </div>

    <!-- Thanh chuyển hướng chương dưới -->
    <div class="read-navigation" style="margin-top: 4rem; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <% if (hasPrev) { %>
            <a href="/story/<%= story.id %>/chapter/<%= prevChapterNum %>" class="btn btn-secondary">&larr; Trước</a>
        <% } else { %>
            <button class="btn btn-secondary" style="opacity: 0.5; cursor: not-allowed;" disabled>&larr; Trước</button>
        <% } %>

        <!-- Mục lục nhanh dạng trượt (Scrollable Dropdown) -->
        <div class="toc-dropdown" style="position: relative; display: inline-block;">
            <button class="btn btn-secondary toc-toggle-btn" style="display: flex; align-items: center; gap: 0.3rem;">
                📖 Mục lục (C. <%= chapter.chapter_number %>) ▾
            </button>
            <div class="toc-dropdown-content" style="display: none; position: absolute; left: 50%; transform: translateX(-50%); top: 100%; margin-top: 0.5rem; background: var(--bg-secondary); min-width: 280px; max-height: 400px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.6); z-index: 1000; padding: 0.4rem 0;">
                <div style="position: sticky; top: 0; background: var(--bg-secondary); padding: 0.4rem 0.6rem 0.6rem 0.6rem; z-index: 1;">
                    <input type="text" class="toc-search-input" placeholder="Tìm chương (ví dụ: 15, tên chương)..." style="width: 100%; padding: 0.5rem 0.7rem; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-primary); font-size: 0.85rem; outline: none;" onclick="event.stopPropagation()">
                </div>
                <div class="toc-search-results">
                    <% chaptersList.forEach(c => { %>
                        <% const isActive = c.chapter_number === chapter.chapter_number; %>
                        <a href="/story/<%= story.id %>/chapter/<%= c.chapter_number %>" data-search="<%= c.chapter_number %> <%= (c.title || '').toLowerCase() %>" style="display: block; padding: 0.65rem 1.2rem; color: <%= isActive ? 'var(--accent-color)' : 'var(--text-primary)' %>; font-size: 0.88rem; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.02); font-weight: <%= isActive ? 'bold' : 'normal' %>; transition: background 0.2s;" class="toc-item <%= isActive ? 'toc-item-active' : '' %>">
                            Chương <%= c.chapter_number %><% if (c.title) { %>: <%= c.title %><% } %>
                        </a>
                    <% }) %>
                </div>
            </div>
        </div>

        <% if (hasNext) { %>
            <a href="/story/<%= story.id %>/chapter/<%= nextChapterNum %>" class="btn btn-primary">Tiếp &rarr;</a>
        <% } else { %>
            <button class="btn btn-primary" style="opacity: 0.5; cursor: not-allowed;" disabled>Tiếp &rarr;</button>
        <% } %>
    </div>
</div>

</style>

<!-- Combined Floating Bar for Focus Reading Toggle, Scroll & EXP Progress -->
<div id="floating-reader-bar" style="position: fixed; right: 20px; bottom: 20px; z-index: 9999; display: flex; align-items: center; gap: 8px;">
    <!-- Nút Kính 👓 Thu Gọn / Mở Rộng Trang Chủ -->
    <div id="read-toggle-header-widget" class="reader-floating-btn" onclick="toggleReadFocusMode()" title="Thu gọn / Mở rộng đầu trang">
        👓
    </div>
    <!-- Nút Lên Đầu Trang ⬆️ -->
    <div id="scroll-to-top-widget" class="reader-floating-btn" onclick="scrollToTop()" title="Lên đầu trang">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 15-6-6-6 6"/>
        </svg>
    </div>
    <!-- Nút Xuống Cuối Trang ⬇️ -->
    <div id="scroll-to-bottom-widget" class="reader-floating-btn" onclick="scrollToBottom()" title="Xuống cuối trang">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
        </svg>
    </div>
    <% if (typeof user !== 'undefined' && user) { %>
        <div id="read-progress-widget" style="background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; padding: 6px 14px; display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-secondary); box-shadow: 0 4px 15px rgba(0,0,0,0.3); transition: all 0.3s ease; white-space: nowrap;">
            <div style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b; animation: pulse 1.5s infinite; flex-shrink: 0;" id="progress-dot"></div>
            <span id="progress-text">Đang nhận EXP... (<span id="progress-timer">1:30</span>)</span>
        </div>
    <% } %>
</div>

<style>
    .read-content {
        white-space: pre-line !important;
    }
    .read-content.has-p-tags {
        white-space: normal !important;
    }

    /* CSS CHO TRÌNH PHÁT AUDIO TRUYỆN AI */
    .audio-player-card {
        background: linear-gradient(135deg, rgba(30, 27, 75, 0.75) 0%, rgba(15, 23, 42, 0.9) 100%);
        border: 1px solid rgba(139, 92, 246, 0.35);
        border-radius: 14px;
        padding: 0.9rem 1.2rem;
        margin: 1.2rem 0 1.8rem 0;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }
    .audio-player-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
    }
    .audio-controls-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-top: 0.8rem;
    }
    .audio-btn {
        background: var(--bg-secondary);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        border-radius: 8px;
        padding: 0.45rem 0.85rem;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.2s ease;
    }
    .audio-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-1px);
    }
    .audio-btn-primary {
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border: none;
        box-shadow: 0 2px 10px rgba(168, 85, 247, 0.4);
    }
    .audio-btn-primary:hover {
        background: linear-gradient(135deg, #4f46e5, #9333ea);
        box-shadow: 0 4px 15px rgba(168, 85, 247, 0.6);
    }
    .audio-select {
        background: rgba(15, 23, 42, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        border-radius: 6px;
        padding: 0.32rem 0.5rem;
        font-size: 0.78rem;
        outline: none;
        cursor: pointer;
    }
    .audio-select:focus {
        border-color: #a855f7;
    }
    .audio-progress-bar-wrap {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        overflow: hidden;
        margin: 0.8rem 0 0.3rem 0;
        cursor: pointer;
    }
    .audio-progress-bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #6366f1, #ec4899);
        transition: width 0.2s linear;
    }
    .audio-active-paragraph {
        background: rgba(168, 85, 247, 0.18) !important;
        border-left: 4px solid #a855f7 !important;
        padding-left: 10px !important;
        border-radius: 4px;
        transition: all 0.3s ease;
    }
    .tts-paragraph {
        transition: background 0.3s ease, border-left 0.3s ease;
        cursor: pointer;
    }
    .tts-paragraph:hover {
        background: rgba(255, 255, 255, 0.03);
    }
    @media (max-width: 600px) {
        .audio-player-card {
            padding: 0.75rem 0.7rem;
            margin: 1rem 0 1.4rem 0;
        }
        .audio-controls-row {
            gap: 0.35rem;
        }
        .audio-btn {
            padding: 0.38rem 0.6rem;
            font-size: 0.75rem;
        }
        .audio-select {
            padding: 0.28rem 0.4rem;
            font-size: 0.74rem;
            max-width: 120px !important;
        }
    }

    /* Styling cho dropdown mục lục nhanh */
    .toc-dropdown-content::-webkit-scrollbar {
        width: 6px;
    }
    .toc-dropdown-content::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.1);
    }
    .toc-dropdown-content::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 3px;
    }
    .toc-dropdown-content::-webkit-scrollbar-thumb:hover {
        background: var(--text-secondary);
    }
    .toc-item:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .toc-item-active {
        background: rgba(99, 102, 241, 0.15) !important;
        color: var(--accent-color) !important;
    }

    /* Các class CSS phục vụ chế độ tập trung đọc (Focus mode) */
    body.focus-reading-mode #main-header {
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.4s ease, opacity 0.4s ease;
    }
    #main-header {
        transition: transform 0.4s ease, opacity 0.4s ease;
    }
    body.focus-reading-mode .read-container {
        padding-top: 1rem !important;
    }
    body.focus-reading-mode .read-header,
    body.focus-reading-mode .read-navigation:first-of-type,
    body.focus-reading-mode .read-container > div:first-of-type {
        display: none !important;
    }
    .reader-floating-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(15, 23, 42, 0.85);
        border: 1.5px solid var(--accent-color);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.25s ease;
        user-select: none;
        flex-shrink: 0;
    }
    .reader-floating-btn:hover {
        transform: translateY(-2px) scale(1.08);
        background: rgba(30, 41, 59, 0.95);
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45);
        color: #fff;
    }
    .reader-floating-btn:active {
        transform: translateY(0) scale(0.95);
    }
    body.focus-reading-mode #read-toggle-header-widget {
        background: var(--accent-color) !important;
        color: #fff !important;
        border-color: transparent !important;
    }

    main.comic-main,
    main:has(.read-container--comic) {
        max-width: 1650px !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 1rem auto !important;
    }

    /* MOBILE RESPONSIVE OPTIMIZATION */
    @media (max-width: 768px) {
        body {
            overflow-x: hidden !important;
        }
        main.comic-main,
        main:has(.read-container--comic) {
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }
        .read-container:not(.read-container--comic) {
            padding: 1rem 0.6rem 4rem 0.6rem !important;
        }
        .read-container--comic {
            padding: 0 0 4rem 0 !important;
            margin: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }
        .read-container--comic .read-content {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }
        .read-container--comic .read-content img {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 auto !important;
            padding: 0 !important;
            display: block !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }
        .read-container--comic .read-header,
        .read-container--comic .read-navigation,
        .read-container--comic #word-count-badge,
        .read-container--comic > div:first-child,
        .read-container--comic .comments-section {
            padding-left: 0.8rem !important;
            padding-right: 0.8rem !important;
        }
        .read-content div:has(> img:only-child) {
            margin-bottom: 0 !important;
            padding: 0 !important;
        }
        .read-content div:has(> img:only-child) img {
            margin: 0 auto !important;
        }
        .read-navigation {
            gap: 0.35rem !important;
            justify-content: space-between !important;
        }
        .read-navigation a, .read-navigation button {
            padding: 0.5rem 0.9rem !important;
            font-size: 0.88rem !important;
        }
        .toc-toggle-btn {
            font-size: 0.88rem !important;
        }
        .toc-dropdown-content {
            min-width: 260px !important;
        }
        #floating-reader-bar {
            right: 12px !important;
            bottom: 12px !important;
            gap: 6px !important;
        }
        .reader-floating-btn {
            width: 34px !important;
            height: 34px !important;
            font-size: 0.95rem !important;
        }
        .reader-floating-btn svg {
            width: 16px !important;
            height: 16px !important;
        }
        #floating-reader-bar #read-progress-widget {
            font-size: 0.78rem !important;
