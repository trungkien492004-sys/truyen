               function formatCommentContent(text) {
                   if (!text) return '';
                   let escaped = text
                       .replace(/&/g, '&amp;')
                       .replace(/</g, '&lt;')
                       .replace(/>/g, '&gt;')
                       .replace(/"/g, '&quot;')
                       .replace(/'/g, '&#039;');

                   for (const name of knownDisplayNames) {
                       const escapedName = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
