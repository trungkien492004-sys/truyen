<script>
    const commentForm = document.getElementById('comment-form');
    if (commentForm) {
        commentForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const textarea = document.getElementById('comment-textarea');
            const content = textarea.value;
            const storyId = '<%= story.id %>';
            const chapterNumber = '<%= chapter.chapter_number %>';

            try {
                const resp = await fetch(`/story/${storyId}/comment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        content,
                        chapter_number: chapterNumber
                    })
                });
                const data = await resp.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.error);
                }
            } catch (err) {
                alert('Lỗi hệ thống: ' + err.message);
            }
        });
    }

    // Like bình luận
    async function likeComment(commentId) {
        try {
            const resp = await fetch(`/comment/${commentId}/like`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await resp.json();
            if (data.success) {
                const commentItem = document.getElementById(`comment-${commentId}`);
                const likeBtn = commentItem.querySelector('.like-btn');
                const likesCountSpan = likeBtn.querySelector('.likes-count');
                
                likesCountSpan.textContent = data.likesCount;
                likeBtn.style.color = data.liked ? 'var(--accent-color)' : 'var(--text-secondary)';
            }
        } catch (err) {
            console.error('Lỗi khi like bình luận:', err);
        }
    }

    // Hiển thị khung trả lời bình luận
    function showReplyForm(targetId, displayName, rootParentId) {
        document.querySelectorAll('[id^="reply-form-"]').forEach(f => f.style.display = 'none');
        
        const form = document.getElementById(`reply-form-${targetId}`);
        const textarea = document.getElementById(`reply-textarea-${targetId}`);
        if (form && textarea) {
            form.style.display = 'block';
            textarea.value = `@${displayName} `;
            textarea.focus();
        }
    }

    function cancelReply(commentId) {
        const form = document.getElementById(`reply-form-${commentId}`);
        if (form) form.style.display = 'none';
    }

    // Gửi phản hồi bình luận
    async function submitReply(parentCommentId, targetReplyId) {
        const inputId = targetReplyId || parentCommentId;
        const textarea = document.getElementById(`reply-textarea-${inputId}`);
        const content = textarea ? textarea.value : '';
        const storyId = '<%= story.id %>';
        const chapterNumber = '<%= chapter.chapter_number %>';

        if (!content || !content.trim()) {
            alert('Vui lòng điền nội dung phản hồi.');
            return;
        }

        try {
            const resp = await fetch(`/story/${storyId}/comment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    content,
                    chapter_number: chapterNumber,
                    parent_id: parentCommentId
                })
            });
            const data = await resp.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Lỗi: ' + data.error);
            }
        } catch (err) {
            alert('Lỗi: ' + err.message);
        }
    }

    // Xóa bình luận
    async function deleteComment(commentId) {
        if (!confirm('Bạn có chắc chắn muốn xóa bình luận này?')) return;
        try {
            const resp = await fetch(`/comment/${commentId}/delete`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await resp.json();
            if (data.success) {
                const commentEl = document.getElementById(`comment-${commentId}`);
                if (commentEl) {
                    commentEl.remove();
                } else {
                    location.reload();
                }
            } else {
                alert(data.error || 'Lỗi khi xóa bình luận.');
            }
        } catch (err) {
            console.error('Lỗi khi xóa bình luận:', err);
            alert('Lỗi hệ thống khi xóa bình luận.');
        }
    }

    <% if (typeof user !== 'undefined' && user) { %>
    // Xử lý countdown tính EXP đọc truyện
    (function() {
        // Sử dụng thời gian yêu cầu được cấu hình và tính toán từ backend để tránh lệch giây
        let secondsLeft = <%= typeof requiredSeconds !== 'undefined' ? requiredSeconds : 90 %>;
        
        const timerSpan = document.getElementById('progress-timer');
        const textSpan = document.getElementById('progress-text');
        const dot = document.getElementById('progress-dot');
        const widget = document.getElementById('read-progress-widget');
        
        // Hiển thị thời gian ban đầu đúng định dạng
        const initMin = Math.floor(secondsLeft / 60);
        const initSec = secondsLeft % 60;
        if (timerSpan) {
            timerSpan.textContent = `${initMin}:${initSec < 10 ? '0' : ''}${initSec}`;
        }
        
        const countdown = setInterval(async () => {
            secondsLeft--;
            
            const minutes = Math.floor(secondsLeft / 60);
            const seconds = secondsLeft % 60;
            if (timerSpan) {
                timerSpan.textContent = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
            }
            
            if (secondsLeft <= 0) {
                clearInterval(countdown);
                
                // Gửi xác nhận đọc chương lên server
                try {
                    const storyId = '<%= story.id %>';
                    const chapterNumber = '<%= chapter.chapter_number %>';
                    
                    const resp = await fetch('/chapter/read-confirm', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ story_id: storyId, chapter_number: chapterNumber })
                    });
                    const data = await resp.json();
                    
                    if (data.success) {
                        textSpan.innerHTML = '🎉 ' + data.message;
                        dot.style.background = '#10b981';
                        dot.style.animation = 'pulse-green 1.5s infinite';

                        // Ẩn nhẹ sau 5s
                        setTimeout(() => {
                            if (widget) {
                                widget.style.opacity = '0.5';
                                widget.style.transform = 'translateY(10px)';
                            }
                        }, 5000);

                        // Nếu vừa lên rank (Đột Phá Cảnh Giới) thì hiện banner, chỉ 1 lần/rank/ngày
                        if (data.rankUp && data.rankUp.to) {
                            const todayStr = new Date().toISOString().slice(0, 10);
                            const seenKey = `rankup_seen_${data.rankUp.to}_${todayStr}`;
                            if (!localStorage.getItem(seenKey)) {
                                localStorage.setItem(seenKey, '1');
                                showRankUpBanner(data.rankUp.from, data.rankUp.to);
                            }
                        }
                    } else {
                        textSpan.textContent = '❌ Lỗi: ' + data.error;
                        dot.style.background = '#ef4444';
                        dot.style.animation = 'none';
                    }
                } catch (err) {
                    console.error('Lỗi khi gửi xác nhận đọc chương:', err);
                    textSpan.textContent = '❌ Lỗi hệ thống ghi nhận EXP.';
                    dot.style.background = '#ef4444';
                    dot.style.animation = 'none';
                }
            }
        }, 1000);
    })();

    function showRankUpBanner(fromRank, toRank) {
        const overlay = document.createElement('div');
        overlay.className = 'rankup-overlay';
        overlay.innerHTML = `
            <div class="rankup-banner">
                <button class="rankup-close" onclick="this.closest('.rankup-overlay').remove()">&times;</button>
                <div class="rankup-icon">⚡</div>
                <div class="rankup-label">ĐỘT PHÁ CẢNH GIỚI</div>
                <div class="rankup-ranks">
                    <span class="rankup-from">${fromRank || 'Nhập Môn'}</span>
                    <span class="rankup-arrow">➜</span>
                    <span class="rankup-to">${toRank}</span>
                </div>
                <div class="rankup-sub">Chúc mừng bạn đã tiến thêm một bước trên con đường tu luyện!</div>
            </div>
        `;
        document.body.appendChild(overlay);
        setTimeout(() => overlay.classList.add('show'), 30);
        setTimeout(() => {
            overlay.classList.remove('show');
            setTimeout(() => overlay.remove(), 500);
        }, 6000);
    }
    <% } %>

    /* ============================================================
       TRÌNH ĐIỀU KHIỂN GIỌNG ĐỌC AUDIO AI (WEB SPEECH API)
       ============================================================ */
    (function initWebSpeechAudio() {
        const audioCard = document.getElementById('ai-audio-player');
        if (!audioCard) return;

        if (!('speechSynthesis' in window)) {
            audioCard.style.display = 'none';
            console.warn('Thiết bị hoặc trình duyệt không hỗ trợ Web Speech API.');
            return;
        }

        const synth = window.speechSynthesis;
        let paragraphs = [];
        let currentIdx = 0;
        let isPlaying = false;
        let isPaused = false;
        let currentUtterance = null;
        let voices = [];

        // DOM Elements
        const btnPlay = document.getElementById('audio-btn-play');
        const btnStop = document.getElementById('audio-btn-stop');
        const btnPrev = document.getElementById('audio-btn-prev');
        const btnNext = document.getElementById('audio-btn-next');
        const selectVoice = document.getElementById('audio-select-voice');
        const selectRate = document.getElementById('audio-select-rate');
        const checkAutoNext = document.getElementById('audio-check-autonext');
        const progressFill = document.getElementById('audio-progress-fill');
        const progressWrap = document.getElementById('audio-progress-wrap');
        const progressText = document.getElementById('audio-progress-text');
        const statusText = document.getElementById('audio-status-text');

        // Phân tách đoạn văn để đọc từng đoạn (tránh timeout của browser)
        function initParagraphs() {
            const contentEl = document.getElementById('chapter-content');
            if (!contentEl) return;

            let pEls = contentEl.querySelectorAll('p');
            if (pEls.length === 0) {
                const raw = contentEl.innerText || '';
                const lines = raw.split(/\n+/).map(l => l.trim()).filter(l => l.length > 0);
                contentEl.innerHTML = '';
                lines.forEach((line, i) => {
                    const p = document.createElement('p');
                    p.className = 'tts-paragraph';
                    p.id = `tts-p-${i}`;
                    p.textContent = line;
                    contentEl.appendChild(p);
                });
                pEls = contentEl.querySelectorAll('p');
            } else {
                pEls.forEach((p, i) => {
                    p.classList.add('tts-paragraph');
                    p.id = `tts-p-${i}`;
                });
            }
            paragraphs = Array.from(pEls);
            updateProgress();
        }

        // Tải danh sách giọng nói từ hệ điều hành / trình duyệt
        function populateVoices() {
            voices = synth.getVoices() || [];
            if (voices.length === 0) return;

            selectVoice.innerHTML = '';
            let viVoiceFound = false;
            const savedVoice = localStorage.getItem('tts_voice_name');

            const viVoices = voices.filter(v => v.lang && (v.lang.toLowerCase().includes('vi')));
            const otherVoices = voices.filter(v => !v.lang || (!v.lang.toLowerCase().includes('vi')));

            if (viVoices.length > 0) {
                const viGroup = document.createElement('optgroup');
                viGroup.label = 'Giọng Tiếng Việt';
                viVoices.forEach(v => {
                    const opt = document.createElement('option');
                    opt.value = v.name;
                    opt.textContent = `🇻🇳 ${v.name}`;
                    if (savedVoice === v.name || (!savedVoice && !viVoiceFound)) {
                        opt.selected = true;
                        viVoiceFound = true;
                    }
                    viGroup.appendChild(opt);
                });
                selectVoice.appendChild(viGroup);
            }

            if (otherVoices.length > 0) {
                const otherGroup = document.createElement('optgroup');
                otherGroup.label = 'Giọng Khác / Mặc định';
                otherVoices.forEach(v => {
                    const opt = document.createElement('option');
                    opt.value = v.name;
                    opt.textContent = `🌐 ${v.name} (${v.lang || 'default'})`;
                    if (savedVoice === v.name && !viVoiceFound) opt.selected = true;
                    otherGroup.appendChild(opt);
                });
                selectVoice.appendChild(otherGroup);
            }
        }

        if (synth.onvoiceschanged !== undefined) {
            synth.onvoiceschanged = populateVoices;
        }
        populateVoices();

        // Khôi phục cài đặt đã lưu
        if (localStorage.getItem('tts_rate')) {
            selectRate.value = localStorage.getItem('tts_rate');
        }
        if (localStorage.getItem('tts_autonext') !== null) {
            checkAutoNext.checked = localStorage.getItem('tts_autonext') === 'true';
        }

        selectRate.addEventListener('change', () => {
            localStorage.setItem('tts_rate', selectRate.value);
            if (isPlaying && !isPaused) speakParagraph(currentIdx);
        });
        selectVoice.addEventListener('change', () => {
            localStorage.setItem('tts_voice_name', selectVoice.value);
            if (isPlaying && !isPaused) speakParagraph(currentIdx);
        });
        checkAutoNext.addEventListener('change', () => {
            localStorage.setItem('tts_autonext', checkAutoNext.checked);
        });

        function updateProgress() {
            if (paragraphs.length === 0) return;
            const pct = Math.min(100, Math.round(((currentIdx + 1) / paragraphs.length) * 100));
            progressFill.style.width = `${pct}%`;
            progressText.innerText = `${currentIdx + 1}/${paragraphs.length} (${pct}%)`;
        }

        function highlightParagraph(idx) {
            paragraphs.forEach((p, i) => {
                if (i === idx) {
                    p.classList.add('audio-active-paragraph');
                    p.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    p.classList.remove('audio-active-paragraph');
                }
            });
        }

        function clearHighlight() {
            paragraphs.forEach(p => p.classList.remove('audio-active-paragraph'));
        }

        function speakParagraph(idx) {
            synth.cancel();
            if (idx < 0 || idx >= paragraphs.length) {
                finishReading();
                return;
            }

            currentIdx = idx;
            updateProgress();
            highlightParagraph(idx);

            const text = paragraphs[idx].innerText.trim();
            if (!text) {
                // Đoạn rỗng, tự động đọc đoạn tiếp theo
                speakParagraph(idx + 1);
                return;
            }

            const utter = new SpeechSynthesisUtterance(text);
            const selectedVoiceName = selectVoice.value;
            const voiceObj = voices.find(v => v.name === selectedVoiceName);
            if (voiceObj) {
                utter.voice = voiceObj;
            } else {
                utter.lang = 'vi-VN';
            }
            utter.rate = parseFloat(selectRate.value) || 1.0;
            utter.pitch = 1.0;

            utter.onstart = () => {
                statusText.innerText = `Đang đọc đoạn ${idx + 1}/${paragraphs.length}...`;
            };

            utter.onend = () => {
                if (isPlaying && !isPaused) {
                    if (currentIdx + 1 < paragraphs.length) {
                        speakParagraph(currentIdx + 1);
                    } else {
                        finishReading();
                    }
                }
            };

            utter.onerror = (e) => {
                if (isPlaying && !isPaused && e.error !== 'interrupted' && e.error !== 'canceled') {
                    console.warn('Lỗi đọc đoạn, chuyển đoạn tiếp:', e);
                    speakParagraph(currentIdx + 1);
                }
            };

            currentUtterance = utter;
            synth.speak(utter);
        }

        function finishReading() {
            isPlaying = false;
            isPaused = false;
            synth.cancel();
            clearHighlight();
            btnPlay.innerHTML = '▶ Nghe Tiếp';
            progressFill.style.width = '100%';

            if (checkAutoNext.checked) {
                <% if (hasNext && nextChapterNum) { %>
                    statusText.innerText = '🎉 Đã đọc xong! Đang chuyển sang Chương <%= nextChapterNum %>...';
                    setTimeout(() => {
                        window.location.href = '/story/<%= story.id %>/chapter/<%= nextChapterNum %>?auto_audio=1';
                    }, 1800);
                <% } else { %>
                    statusText.innerText = '📖 Chúc mừng bạn đã đọc xong chương cuối cùng!';
                <% } %>
            } else {
                statusText.innerText = 'Đã đọc hết chương!';
            }
        }

        btnPlay.addEventListener('click', () => {
            if (!isPlaying) {
                isPlaying = true;
                isPaused = false;
                btnPlay.innerHTML = '⏸ Tạm Dừng';
                speakParagraph(currentIdx);
            } else if (isPaused) {
                isPaused = false;
                btnPlay.innerHTML = '⏸ Tạm Dừng';
                synth.resume();
                statusText.innerText = `Đang đọc tiếp đoạn ${currentIdx + 1}...`;
            } else {
                isPaused = true;
                btnPlay.innerHTML = '▶ Tiếp Tục';
                synth.pause();
                statusText.innerText = 'Đã tạm dừng đọc';
            }
        });

        btnStop.addEventListener('click', () => {
            isPlaying = false;
            isPaused = false;
            synth.cancel();
            clearHighlight();
            currentIdx = 0;
            updateProgress();
            btnPlay.innerHTML = '▶ Nghe Truyện';
            statusText.innerText = 'Đã dừng hẳn';
        });

        btnPrev.addEventListener('click', () => {
            if (currentIdx > 0) {
                currentIdx--;
                if (isPlaying && !isPaused) {
                    speakParagraph(currentIdx);
                } else {
                    updateProgress();
                    highlightParagraph(currentIdx);
                }
            }
        });

        btnNext.addEventListener('click', () => {
            if (currentIdx + 1 < paragraphs.length) {
                currentIdx++;
                if (isPlaying && !isPaused) {
                    speakParagraph(currentIdx);
                } else {
                    updateProgress();
                    highlightParagraph(currentIdx);
                }
            }
        });

        // Bấm trực tiếp vào thanh tiến trình để tua đoạn
        if (progressWrap) {
            progressWrap.addEventListener('click', (e) => {
                const rect = progressWrap.getBoundingClientRect();
                const clickX = e.clientX - rect.left;
                const ratio = Math.max(0, Math.min(1, clickX / rect.width));
                const targetIdx = Math.floor(ratio * paragraphs.length);
                currentIdx = Math.min(paragraphs.length - 1, targetIdx);
                if (isPlaying && !isPaused) {
                    speakParagraph(currentIdx);
                } else {
                    updateProgress();
                    highlightParagraph(currentIdx);
                }
            });
        }

        // Bấm vào bất kỳ đoạn văn nào trên bài viết để AI đọc ngay từ đoạn đó
        const contentEl = document.getElementById('chapter-content');
        if (contentEl) {
            contentEl.addEventListener('click', (e) => {
                const p = e.target.closest('.tts-paragraph');
                if (p) {
                    const idx = paragraphs.indexOf(p);
                    if (idx !== -1) {
                        currentIdx = idx;
                        if (!isPlaying) {
                            isPlaying = true;
                            isPaused = false;
                            btnPlay.innerHTML = '⏸ Tạm Dừng';
                        }
                        speakParagraph(currentIdx);
                    }
                }
            });
        }

        initParagraphs();

        // Tự động phát tiếp nếu chuyển từ chương trước sang qua URL param
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('auto_audio') === '1') {
            setTimeout(() => {
                btnPlay.click();
            }, 800);
        }
    })();
</script>

