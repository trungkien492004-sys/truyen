</style>

<script>
    document.querySelectorAll('.toc-toggle-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const content = btn.nextElementSibling;
            const isVisible = content.style.display === 'block';
            
            // Đóng tất cả mục lục nhanh khác
            document.querySelectorAll('.toc-dropdown-content').forEach(c => c.style.display = 'none');
            
            if (!isVisible) {
                content.style.display = 'block';
                // Cuộn chương hiện tại vào giữa danh sách để tiện theo dõi
                const activeItem = content.querySelector('.toc-item-active');
                if (activeItem) {
                    content.scrollTop = activeItem.offsetTop - content.clientHeight / 2 + activeItem.clientHeight / 2;
                }
            }
        });
    });

    // Bấm ra ngoài thì đóng mục lục nhanh
    document.addEventListener('click', () => {
        document.querySelectorAll('.toc-dropdown-content').forEach(c => c.style.display = 'none');
    });

    // Cuộn mượt lên đầu trang hoặc xuống cuối trang
    function scrollToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function scrollToBottom() {
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
    }

    // Ẩn/Hiện Header & Navigation (Focus reading mode)
    function toggleReadFocusMode() {
        const isFocus = document.body.classList.toggle('focus-reading-mode');
        localStorage.setItem('focus_reading_mode', isFocus ? 'yes' : 'no');
    }

    // Tự động khôi phục chế độ Focus từ lần đọc trước
    document.addEventListener('DOMContentLoaded', () => {
        if (localStorage.getItem('focus_reading_mode') === 'yes') {
            document.body.classList.add('focus-reading-mode');
        }
    });

    // Gõ tìm kiếm chương ngay trong dropdown Mục lục
    document.querySelectorAll('.toc-search-input').forEach(input => {
        input.addEventListener('input', () => {
            const keyword = input.value.trim().toLowerCase();
            const container = input.closest('.toc-dropdown-content').querySelector('.toc-search-results');
            const items = container.querySelectorAll('a.toc-item');

            items.forEach(item => {
                const matched = !keyword || (item.dataset.search || '').includes(keyword);
                item.style.display = matched ? 'block' : 'none';
            });
        });
    });

    // Đếm số từ trong nội dung chương
    (function countWords() {
        const contentEl = document.getElementById('chapter-content');
        const countEl = document.getElementById('word-count-num');
        if (!contentEl || !countEl) return;
        // Lấy text thuần, loại bỏ HTML tags
        const text = contentEl.innerText || contentEl.textContent || '';
        // Tách từ bằng dấu cách/xuống dòng, lọc chuỗi rỗng
        const words = text.trim().split(/\s+/).filter(w => w.length > 0);
        const count = words.length;
        // Format số có dấu phẩy mỗi nghìn
        countEl.textContent = count.toLocaleString('vi-VN');
    })();
</script>

