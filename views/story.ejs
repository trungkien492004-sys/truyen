<%- include('partials/header') %>

<div style="margin-bottom: 1.5rem;">
    <a href="/" style="color: var(--text-secondary); font-size: 0.9rem;">&larr; Quay lại trang chủ</a>
</div>

<div class="story-detail-header">
    <img src="<%= story.cover_url %>" alt="<%= story.title %>" class="story-detail-cover" onerror="this.onerror=null; this.src='/css/default-cover.jpg';" decoding="async">
    
    <div class="story-detail-info">
        <div style="display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
            <h1 class="story-detail-title" style="margin: 0;"><%= story.title %></h1>
            <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'sp_admin')) { %>
                <a href="/admin/story/edit/<%= story.id %>" class="btn btn-secondary" style="padding: 0.3rem 0.8rem; font-size: 0.8rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.3rem; text-decoration: none; border: 1px solid rgba(59, 130, 246, 0.3); background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-weight: 500; transition: all 0.2s;">
                    ✏️ Sửa Truyện
                </a>
            <% } %>
        </div>
        <div class="story-detail-author">Tác giả: <a href="/author/<%= encodeURIComponent(story.author || '') %>" style="color: var(--accent-color); text-decoration: none; font-weight: bold;"><%= story.author %></a></div>
        
        <div class="story-detail-meta" style="margin-bottom: 1.2rem;">
            <!-- Hiển thị thể loại dạng Flexwrap tránh đè chữ -->
            <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; line-height: 1.8;">
                <span style="color: var(--text-secondary); font-weight: 500;">Thể loại:</span>
                <% if (genres && genres.length > 0) { %>
                    <% genres.forEach(genre => { %>
                        <a href="/genre/<%= genre.slug %>" class="detail-genre-tag" style="padding: 0.25rem 0.75rem; font-size: 0.8rem; border-radius: 12px; display: inline-flex; align-items: center; border: 1px solid var(--border-color); background: var(--bg-secondary); color: var(--text-primary); text-decoration: none; font-weight: 500; transition: all 0.2s;">
                            <%= genre.name %>
                        </a>
                    <% }) %>
                <% } else { %>
                    <span style="color: var(--text-secondary);">Chưa phân loại</span>
                <% } %>
                <% if (story.story_type !== 'comic') { %>
                    <span style="background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.4); color: #c084fc; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.3rem;">
                        🎧 Có Audio AI
                    </span>
                <% } %>
            </div>
        </div>

        <!-- ĐÁNH GIÁ TRUYỆN (SAO/ĐIỂM) -->
        <div style="margin-bottom: 1rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <div>
                ⭐ <strong><%= typeof avgScore !== 'undefined' && avgScore ? avgScore : 'Chưa có' %></strong><% if (typeof avgScore !== 'undefined' && avgScore) { %>/10<% } %>
                <span style="color: var(--text-secondary); font-size: 0.85rem;">(<%= typeof ratingCount !== 'undefined' ? ratingCount : 0 %> lượt đánh giá)</span>
            </div>

            <% if (typeof user !== 'undefined' && user) { %>
                <div id="rating-widget" data-story-id="<%= story.id %>" style="display: flex; gap: 0.2rem; cursor: pointer;">
                    <% for (let i = 1; i <= 10; i++) { %>
                        <span class="rate-star" data-score="<%= i %>" style="font-size: 1.1rem; color: <%= (typeof myRating !== 'undefined' && myRating && i <= myRating) ? '#f59e0b' : 'var(--border-color)' %>;">★</span>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- HIỂN THỊ THÔNG TIN NGƯỜI ĐẶT TRUYỆN NẾU CÓ -->
        <% if (story.commissioned_by) { %>
            <div style="margin-bottom: 1.5rem; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 8px; padding: 0.8rem 1.2rem; display: flex; align-items: center; gap: 0.5rem; max-width: fit-content;">
                <span>👑</span>
                <span>Truyện viết theo yêu cầu của độc giả: <strong><%= story.commissioned_by %></strong></span>
            </div>
        <% } %>

        <div class="story-detail-desc">
            <h3>Tóm tắt truyện:</h3>
            <p><%= story.description || 'Nội dung bộ truyện đang được cập nhật...' %></p>
        </div>

        <div style="display: flex; gap: 0.8rem; flex-wrap: wrap; align-items: center;">
            <% if (chapters && chapters.length > 0) { %>
                <% const targetChap = (typeof readingProgress !== 'undefined' && readingProgress) ? readingProgress : chapters[0].chapter_number; %>
                <% if (typeof readingProgress !== 'undefined' && readingProgress) { %>
                    <a href="/story/<%= story.id %>/chapter/<%= readingProgress %>" class="btn btn-primary" style="padding: 0.8rem 2rem;">TIẾP TỤC ĐỌC (Chương <%= readingProgress %>)</a>
                <% } else { %>
                    <a href="/story/<%= story.id %>/chapter/<%= chapters[0].chapter_number %>" class="btn btn-primary" style="padding: 0.8rem 2rem;">ĐỌC TỪ ĐẦU</a>
                <% } %>
                <% if (story.story_type !== 'comic') { %>
                    <a href="/story/<%= story.id %>/chapter/<%= targetChap %>?auto_audio=1" class="btn" style="padding: 0.8rem 1.6rem; border-radius: 8px; font-weight: 700; background: linear-gradient(135deg, #6366f1, #a855f7); color: white; display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);">
                        🎧 Nghe Audio AI
                    </a>
                <% } %>
            <% } %>

            <% if (typeof user !== 'undefined' && user) { %>
                <button id="bookmark-btn" data-story-id="<%= story.id %>" data-bookmarked="<%= bookmarkStatus ? 'true' : 'false' %>" class="btn <%= bookmarkStatus ? 'btn-secondary' : 'btn-primary' %>" style="padding: 0.8rem 1.8rem; border-radius: 8px; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
                    <%= bookmarkStatus ? '💔 Bỏ theo dõi' : '❤️ Theo dõi' %>
                </button>
            <% } %>

            <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'sp_admin')) { %>
                <a href="/story/download-epub/<%= story.id %>" class="btn btn-secondary" style="padding: 0.8rem 1.5rem; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2); color: #10b981; text-decoration: none;">📥 Tải EPUB</a>
            <% } %>
        </div>
    </div>
</div>

<script>
    // Xử lý click sao đánh giá truyện
    const ratingWidget = document.getElementById('rating-widget');
    if (ratingWidget) {
        const stars = ratingWidget.querySelectorAll('.rate-star');
        stars.forEach(star => {
            star.addEventListener('click', async () => {
                const score = star.dataset.score;
                const storyId = ratingWidget.dataset.storyId;
                try {
                    const resp = await fetch(`/rate/${storyId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ score })
                    });
                    const data = await resp.json();
                    if (data.success) {
                        stars.forEach(s => {
                            s.style.color = parseInt(s.dataset.score) <= parseInt(score) ? '#f59e0b' : 'var(--border-color)';
                        });
                        location.reload();
                    } else {
                        alert('Lỗi: ' + data.error);
                    }
                } catch (err) {
                    alert('Có lỗi xảy ra: ' + err.message);
                }
            });
        });
    }

    const bookmarkBtn = document.getElementById('bookmark-btn');
    if (bookmarkBtn) {
        bookmarkBtn.addEventListener('click', async () => {
            const storyId = bookmarkBtn.dataset.storyId;
            const isBookmarked = bookmarkBtn.dataset.bookmarked === 'true';
            try {
                const resp = await fetch(`/bookmark/${storyId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(isBookmarked ? { remove: true } : { status: 'reading' })
                });
                const data = await resp.json();
                if (data.success) {
                    if (isBookmarked) {
                        bookmarkBtn.dataset.bookmarked = 'false';
                        bookmarkBtn.className = 'btn btn-primary';
                        bookmarkBtn.innerHTML = '❤️ Theo dõi';
                    } else {
                        bookmarkBtn.dataset.bookmarked = 'true';
                        bookmarkBtn.className = 'btn btn-secondary';
                        bookmarkBtn.innerHTML = '💔 Bỏ theo dõi';
                    }
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.error);
                }
            } catch (err) {
                alert('Có lỗi xảy ra: ' + err.message);
            }
        });
    }
</script>

<div class="chapters-container">
    <% if (chapters && chapters.length > 0) { 
        const latestChapters = chapters.slice(-5).reverse();
    %>
        <!-- MỤC 5 CHƯƠNG MỚI NHẤT -->
        <div class="latest-chapters-box" style="margin-bottom: 1.5rem; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 1.2rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; border-bottom: 1px solid rgba(255, 255, 255, 0.06); padding-bottom: 0.6rem;">
                <h3 style="margin: 0; font-size: 1.15rem; color: #f59e0b; display: flex; align-items: center; gap: 0.5rem;">
                    🔥 5 chương mới nhất
                </h3>
                <span style="font-size: 0.8rem; color: var(--text-secondary);">Mới cập nhật</span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.6rem;">
                <% latestChapters.forEach(chap => { %>
                    <a href="/story/<%= story.id %>/chapter/<%= chap.chapter_number %>" style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.9rem; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; text-decoration: none; color: var(--text-primary); transition: all 0.2s;" onmouseover="this.style.borderColor='var(--accent-color)'; this.style.background='rgba(99,102,241,0.1)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'; this.style.background='rgba(0,0,0,0.25)'">
                        <span style="font-weight: 500; font-size: 0.92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; margin-right: 0.5rem;">
                            <% if (chap.title && chap.title.toLowerCase().startsWith('chương')) { %>
                                <strong><%= chap.title %></strong>
                            <% } else { %>
                                <strong>Chương <%= chap.chapter_number %></strong><% if (chap.title) { %>: <%= chap.title %><% } %>
                            <% } %>
                        </span>
                        <div style="font-size: 0.78rem; color: var(--text-secondary); white-space: nowrap; flex-shrink: 0; display: flex; align-items: center; gap: 0.5rem;">
                            <span style="display: inline-flex; align-items: center; gap: 0.2rem;" title="Lượt xem chương">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.7;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                <%= chap.views || 0 %>
                            </span>
                            <% if (chap.created_at) { %>
                                <span>• <%= new Date(chap.created_at).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }) %></span>
                            <% } %>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    <% } %>

    <div style="background: rgba(255,255,255,0.04); padding: 1rem 1.2rem; border-radius: 12px; margin-bottom: 1rem; border: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.6rem;">
        <h2 class="section-title" style="margin: 0; font-size: 1.25rem;">
            📖 Danh sách chương (<%= chapters ? chapters.length : 0 %>)
        </h2>
        <div style="font-size: 0.82rem; color: var(--text-secondary);">
            <% if (chapters && chapters.length > 0) { %>
                Cập nhật mới nhất: Chương <%= chapters[chapters.length - 1].chapter_number %>
            <% } %>
        </div>
    </div>
    
    <div id="chapters-wrapper">
        <% if (!chapters || chapters.length === 0) { %>
            <p style="color: var(--text-secondary); text-align: center; padding: 2rem 0;">Truyện hiện tại chưa có chương nào. Vui lòng quay lại sau!</p>
        <% } else { %>
            <!-- Thanh tìm kiếm chương -->
            <div style="margin-bottom: 0.8rem;">
                <input type="text" id="chapter-search" placeholder="🔍 Tìm kiếm chương (ví dụ: 1, 50, tiêu đề)..." style="width: 100%; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-primary); font-size: 0.92rem; outline: none; transition: border-color 0.3s;" oninput="onChapterSearch(this.value)" onfocus="this.style.borderColor='var(--accent-color)'" onblur="this.style.borderColor='var(--border-color)'">
            </div>

            <!-- PHÂN ĐOẠN 50 CHƯƠNG CHUYÊN NGHIỆP NẾU > 50 CHƯƠNG -->
            <% if (chapters.length > 50) { %>
                <% const PAGE_SIZE = 50; const totalPages = Math.ceil(chapters.length / PAGE_SIZE); %>
                <div class="chapter-range-tabs" id="chapter-range-tabs-bar" style="display: flex; gap: 0.4rem; overflow-x: auto; padding-bottom: 0.6rem; margin-bottom: 0.8rem; scrollbar-width: thin;">
                    <% for (let p = 0; p < totalPages; p++) { %>
                        <% const startNum = p * PAGE_SIZE + 1; const endNum = Math.min((p + 1) * PAGE_SIZE, chapters.length); %>
                        <button type="button" class="chapter-page-btn <%= p === 0 ? 'active' : '' %>" onclick="switchChapterPage(<%= p %>)" id="chap-page-btn-<%= p %>" style="padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer; white-space: nowrap; border: 1px solid rgba(255,255,255,0.1); background: <%= p === 0 ? 'var(--accent-color)' : 'rgba(255,255,255,0.05)' %>; color: <%= p === 0 ? '#fff' : 'var(--text-secondary)' %>; transition: all 0.2s;">
                            Chương <%= startNum %> - <%= endNum %>
                        </button>
                    <% } %>
                    <button type="button" class="chapter-page-btn" onclick="showAllChapters()" id="chap-page-btn-all" style="padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.82rem; font-weight: 600; cursor: pointer; white-space: nowrap; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); color: var(--text-secondary); transition: all 0.2s;">
                        Tất Cả (<%= chapters.length %>)
                    </button>
                </div>
            <% } %>

            <!-- Danh sách chương -->
            <div class="chapters-list-container" style="max-height: 520px; overflow-y: auto; padding-right: 5px;" id="chapters-list-ul">
                <ul class="chapters-list" style="margin-top: 0; padding-top: 0.2rem;">
                    <% chapters.forEach((chapter, idx) => { %>
                        <li class="chapter-item-container" data-idx="<%= idx %>" data-chap-num="<%= chapter.chapter_number %>" data-search="<%= chapter.chapter_number %> <%= (chapter.title || '').toLowerCase() %>" style="display: flex; align-items: center; gap: 0.5rem; width: 100%;">
                            <a href="/story/<%= story.id %>/chapter/<%= chapter.chapter_number %>" class="chapter-item" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex: 1; min-width: 0;">
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;">
                                    <% if (chapter.title && chapter.title.toLowerCase().startsWith('chương')) { %>
                                        <strong><%= chapter.title %></strong>
                                    <% } else { %>
                                        <strong>Chương <%= chapter.chapter_number %></strong><% if (chapter.title) { %>: <%= chapter.title %><% } %>
                                    <% } %>
                                </span>
                                <span style="font-size: 0.8rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.3rem; flex-shrink: 0;" title="Lượt xem chương">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.7;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    <%= chapter.views || 0 %>
                                </span>
                            </a>
                            <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'sp_admin')) { %>
                                <a href="/admin/chapter/edit/<%= chapter.id %>?redirect_to=/story/<%= story.id %>" class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; border-radius: 4px; border: 1px solid rgba(59, 130, 246, 0.3); background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-weight: 500; text-decoration: none; white-space: nowrap; flex-shrink: 0;" title="Sửa chương nhanh">
                                    ✏️ Sửa
                                </a>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            </div>

            <!-- Nút chuyển 50 chương tiếp theo bên dưới danh sách -->
            <% if (chapters.length > 50) { %>
                <div id="chapter-next-page-wrap" style="margin-top: 0.9rem; display: flex; justify-content: center; gap: 0.8rem; flex-wrap: wrap;">
                    <button type="button" id="btn-next-50-chapters" onclick="goToNextChapterPage()" class="btn btn-primary" style="padding: 0.6rem 1.4rem; font-size: 0.88rem; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; gap: 0.4rem;">
                        👉 Xem 50 chương sau (Chương 51 - <%= Math.min(100, chapters.length) %>) &rarr;
                    </button>
                    <button type="button" onclick="showAllChapters()" class="btn btn-secondary" style="padding: 0.6rem 1rem; font-size: 0.88rem; border-radius: 8px;">
                        📖 Xem Toàn Bộ (<%= chapters.length %> chương)
                    </button>
                </div>
            <% } %>
        <% } %>
    </div>
</div>

<style>
    #chapters-wrapper {
        transition: opacity 0.3s ease;
    }
    #chapters-list-ul::-webkit-scrollbar {
        width: 6px;
    }
    #chapters-list-ul::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.2);
        border-radius: 3px;
    }
    .chapter-range-tabs::-webkit-scrollbar {
        height: 4px;
    }
    .chapter-range-tabs::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.2);
        border-radius: 2px;
    }
</style>

<script>
    const TOTAL_CHAPTERS = <%= chapters ? chapters.length : 0 %>;
    const CHAPT_PAGE_SIZE = 50;
    let currentChapterPage = 0;
    const totalChapterPages = Math.ceil(TOTAL_CHAPTERS / CHAPT_PAGE_SIZE);

    function renderChapterPage(pageIndex) {
        currentChapterPage = pageIndex;
        const allItems = document.querySelectorAll('.chapter-item-container');
        const startIdx = pageIndex * CHAPT_PAGE_SIZE;
        const endIdx = startIdx + CHAPT_PAGE_SIZE;

        allItems.forEach((el, idx) => {
            if (idx >= startIdx && idx < endIdx) {
                el.style.setProperty('display', 'flex', 'important');
            } else {
                el.style.setProperty('display', 'none', 'important');
            }
        });

        // Cập nhật tab active
        document.querySelectorAll('.chapter-page-btn').forEach(b => {
            b.style.background = 'rgba(255,255,255,0.05)';
            b.style.color = 'var(--text-secondary)';
            b.classList.remove('active');
        });
        const activeBtn = document.getElementById(`chap-page-btn-${pageIndex}`);
        if (activeBtn) {
            activeBtn.style.background = 'var(--accent-color)';
            activeBtn.style.color = '#fff';
            activeBtn.classList.add('active');
            activeBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        // Cập nhật nút Next 50 bên dưới
        const nextWrap = document.getElementById('chapter-next-page-wrap');
        const nextBtn = document.getElementById('btn-next-50-chapters');
        if (nextBtn && nextWrap) {
            if (pageIndex + 1 < totalChapterPages) {
                nextWrap.style.display = 'flex';
                const nextStart = (pageIndex + 1) * CHAPT_PAGE_SIZE + 1;
                const nextEnd = Math.min((pageIndex + 2) * CHAPT_PAGE_SIZE, TOTAL_CHAPTERS);
                nextBtn.innerHTML = `👉 Xem 50 chương sau (Chương ${nextStart} - ${nextEnd}) &rarr;`;
            } else {
                nextBtn.style.display = 'none';
            }
        }
    }

    function switchChapterPage(p) {
        const searchInput = document.getElementById('chapter-search');
        if (searchInput) searchInput.value = '';
        renderChapterPage(p);
        const ul = document.getElementById('chapters-list-ul');
        if (ul) ul.scrollTop = 0;
    }

    function goToNextChapterPage() {
        if (currentChapterPage + 1 < totalChapterPages) {
            switchChapterPage(currentChapterPage + 1);
        }
    }

    function showAllChapters() {
        const searchInput = document.getElementById('chapter-search');
        if (searchInput) searchInput.value = '';
        const allItems = document.querySelectorAll('.chapter-item-container');
        allItems.forEach(el => el.style.setProperty('display', 'flex', 'important'));

        document.querySelectorAll('.chapter-page-btn').forEach(b => {
            b.style.background = 'rgba(255,255,255,0.05)';
            b.style.color = 'var(--text-secondary)';
        });
        const allBtn = document.getElementById('chap-page-btn-all');
        if (allBtn) {
            allBtn.style.background = 'var(--accent-color)';
            allBtn.style.color = '#fff';
        }

        const nextWrap = document.getElementById('chapter-next-page-wrap');
        if (nextWrap) nextWrap.style.display = 'none';
    }

    function onChapterSearch(keyword) {
        keyword = keyword.toLowerCase().trim();
        const allItems = document.querySelectorAll('.chapter-item-container');
        const nextWrap = document.getElementById('chapter-next-page-wrap');

        if (!keyword) {
            renderChapterPage(currentChapterPage);
            if (nextWrap) nextWrap.style.display = 'flex';
            return;
        }

        // Khi tìm kiếm: Quét toàn bộ mọi chương
        if (nextWrap) nextWrap.style.display = 'none';
        allItems.forEach(el => {
            const str = el.getAttribute('data-search') || '';
            if (str.includes(keyword)) {
                el.style.setProperty('display', 'flex', 'important');
            } else {
                el.style.setProperty('display', 'none', 'important');
            }
        });
    }

    // Khởi tạo mặc định: Hiển thị 50 chương đầu tiên
    document.addEventListener('DOMContentLoaded', () => {
        if (TOTAL_CHAPTERS > CHAPT_PAGE_SIZE) {
            renderChapterPage(0);
        }
    });
</script>

<div class="chapters-container" style="margin-top: 3rem;">
    <h2 class="section-title" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; font-size: 1.3rem;">
        💬 Bình luận (<%= comments.length %>)
    </h2>

    <% if (typeof user !== 'undefined' && user) { %>
        <!-- New Comment Form -->
        <form id="comment-form" style="display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 2rem;">
            <textarea id="comment-textarea" placeholder="Viết bình luận của bạn ở đây... Nhắc tên ai đó bằng cách gõ @Tên hiển thị" required style="width: 100%; min-height: 80px; padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); font-size: 0.9rem; line-height: 1.5; resize: vertical; transition: border-color 0.3s;"></textarea>
            <button type="submit" class="btn btn-primary" style="align-self: flex-end; padding: 0.5rem 1.5rem; font-size: 0.88rem; border-radius: 8px;">Đăng bình luận</button>
        </form>
    <% } else { %>
        <p style="background: rgba(255,255,255,0.02); border: 1px dashed var(--border-color); border-radius: 10px; padding: 1rem; text-align: center; color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem;">
            Vui lòng <a href="/auth/login" style="color: var(--accent-color); font-weight: bold; text-decoration: none;">Đăng nhập</a> để tham gia bình luận.
        </p>
    <% } %>

    <div class="comments-list" style="display: flex; flex-direction: column; gap: 1.5rem;">
        <% if (comments.length === 0) { %>
            <p style="color: var(--text-secondary); text-align: center; padding: 1.5rem 0; font-size: 0.92rem;">Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nghĩ!</p>
        <% } else { %>
            <!-- Phân tách bình luận gốc và phản hồi -->
            <% 
               const knownDisplayNames = Array.from(new Set((comments || []).map(c => c.users && c.users.display_name ? c.users.display_name.trim() : '').filter(Boolean))).sort((a, b) => b.length - a.length);

               function formatCommentContent(text) {
                   if (!text) return '';
                   let escaped = text
                       .replace(/&/g, '&amp;')
                       .replace(/</g, '&lt;')
                       .replace(/>/g, '&gt;')
                       .replace(/"/g, '&quot;')
                       .replace(/'/g, '&#039;');

                   for (const name of knownDisplayNames) {
                       const escapedName = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                       const regex = new RegExp('@' + escapedName + '(?=[\\s,.:!?]|$)', 'g');
                       escaped = escaped.replace(regex, '<span style="color:var(--accent-color); font-weight:600;">@' + name + '</span>');
                   }
                   escaped = escaped.replace(/@([a-zA-Z0-9_\u00C0-\u024F\u1EA0-\u1EF9]+)/g, '<span style="color:var(--accent-color); font-weight:600;">@$1</span>');
                   return escaped;
               }

               const topLevelComments = comments.filter(c => !c.parent_id); 
            %>
            <% topLevelComments.forEach(comment => { %>
                <div class="comment-item" id="comment-<%= comment.id %>" style="display: flex; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 1rem;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.3rem; flex-shrink: 0; min-width: 60px;">
                        <a href="/user/<%= comment.user_id %>" style="display: inline-block; position: relative;">
                            <% const cFrameClass = (comment.users && comment.users.equipped_frame) ? comment.users.equipped_frame : 'default-frame'; %>
                            <div class="avatar-frame <%= cFrameClass %>" style="width: 42px; height: 42px; padding: 2px;">
                                <div class="avatar-glow"></div>
                                <img src="<%= comment.users ? comment.users.avatar : '/css/silly_duck.png' %>" alt="avatar" class="avatar-img" style="border-width: 1px;">
                                <% if (comment.users && comment.users.equipped_badge) { %>
                                    <div class="avatar-corner" style="position: absolute; top: -4px; right: -4px; font-size: 0.8rem; background: rgba(0,0,0,0.6); border-radius: 50%; padding: 2px; z-index: 10; border: 1px solid gold; display: flex; justify-content: center; align-items: center; width: 18px; height: 18px;">
                                        <%= getBadgeIcon(comment.users.equipped_badge) %>
                                    </div>
                                <% } %>
                            </div>
                        </a>
                        <% if (comment.users && comment.users.equipped_badge) { %>
                            <div style="display: flex; flex-direction: column; align-items: center; margin-top: 4px; z-index: 2; line-height: 1.1;">
                                <span class="game-title <%= getTitleRarityClass(comment.users.equipped_badge) %>" style="white-space: nowrap; font-size: 0.55rem !important; padding: 2px 8px !important; animation: none !important; transform: none !important; height: auto !important; width: max-content !important;"><%= comment.users.equipped_badge %></span>
                                <span style="font-size: 0.45rem; color: #ffd700; letter-spacing: 1px; text-shadow: 0 0 2px rgba(255,255,255,0.3); margin-top: 2px;"><%= getStarsByChapters(comment.users.user_stats ? comment.users.user_stats.chapters_read : 0) %></span>
                            </div>
                        <% } %>
                    </div>
                    
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.3rem;">
                            <span style="font-weight: 600; font-size: 0.92rem;">
                                <a href="/user/<%= comment.user_id %>" style="text-decoration: none; color: inherit; transition: color 0.2s;" onmouseover="this.style.color='var(--accent-color)'" onmouseout="this.style.color='inherit'">
                                    <%= comment.users ? comment.users.display_name : 'Độc giả ẩn danh' %>
                                </a>
                                <% if (comment.chapter_number) { %>
                                    <span style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.25); padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.72rem; margin-left: 0.4rem; font-weight: 500;">
                                        Chương <%= comment.chapter_number %>
                                    </span>
                                <% } %>
                            </span>
                            <span style="font-size: 0.78rem; color: var(--text-secondary);"><%= new Date(comment.created_at).toLocaleDateString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %></span>
                        </div>
                        
                        <!-- Nội dung comment có highlight tags chuẩn xác -->
                        <div class="comment-content" style="font-size: 0.9rem; line-height: 1.6; color: var(--text-primary); white-space: pre-wrap; margin-bottom: 0.6rem;"><%- formatCommentContent(comment.content) %></div>
                        
                        <!-- Action buttons -->
                        <div style="display: flex; align-items: center; gap: 1.2rem; font-size: 0.8rem; color: var(--text-secondary);">
                            <button onclick="likeComment(<%= comment.id %>)" class="like-btn" style="background: none; border: none; color: <%= comment.user_liked ? 'var(--accent-color)' : 'var(--text-secondary)' %>; cursor: pointer; display: flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; padding: 0;">
                                ❤️ <span class="likes-count"><%= comment.likes_count %></span> Thích
                            </button>
                            <% if (typeof user !== 'undefined' && user) { %>
                                <button onclick="showReplyForm(<%= comment.id %>, '<%= comment.users ? comment.users.display_name : '' %>')" style="background: none; border: none; color: var(--text-secondary); cursor: pointer; padding: 0; font-size: 0.8rem;">
                                    💬 Trả lời
                                </button>
                            <% } %>
                            <% if (typeof user !== 'undefined' && user && (user.id === comment.user_id || user.role === 'admin' || user.role === 'sp_admin')) { %>
                                <button onclick="deleteComment(<%= comment.id %>)" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 0; font-size: 0.8rem; display: flex; align-items: center; gap: 0.2rem;">
                                    🗑️ Xóa
                                </button>
                            <% } %>
                        </div>

                        <!-- Form trả lời ẩn dành cho bình luận gốc -->
                        <div id="reply-form-<%= comment.id %>" style="display: none; margin-top: 1rem; background: rgba(0,0,0,0.15); border-radius: 8px; padding: 0.8rem;">
                            <textarea id="reply-textarea-<%= comment.id %>" placeholder="Viết câu trả lời của bạn..." required style="width: 100%; min-height: 60px; padding: 0.5rem 0.8rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); font-size: 0.85rem; line-height: 1.4; resize: vertical; margin-bottom: 0.5rem;"></textarea>
                            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                                <button onclick="cancelReply(<%= comment.id %>)" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px;">Hủy</button>
                                <button onclick="submitReply(<%= comment.id %>)" class="btn btn-primary" style="font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px;">Trả lời</button>
                            </div>
                        </div>

                        <!-- Danh sách phản hồi lồng nhau (Sắp xếp theo thứ tự thời gian đối thoại) -->
                        <% const replies = comments.filter(c => c.parent_id === comment.id).sort((a, b) => new Date(a.created_at) - new Date(b.created_at)); %>
                        <% if (replies.length > 0) { %>
                            <div class="replies-container" style="margin-top: 1rem; padding-left: 1rem; border-left: 2px solid var(--border-color); display: flex; flex-direction: column; gap: 1rem;">
                                <% replies.forEach(reply => { %>
                                    <div class="comment-item" id="comment-<%= reply.id %>" style="display: flex; gap: 0.8rem; flex-direction: column;">
                                        <div style="display: flex; gap: 0.8rem; width: 100%;">
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 0.2rem; flex-shrink: 0; min-width: 45px;">
                                                <a href="/user/<%= reply.user_id %>" style="display: inline-block; position: relative;">
                                                    <% const rFrameClass = (reply.users && reply.users.equipped_frame) ? reply.users.equipped_frame : 'default-frame'; %>
                                                    <div class="avatar-frame <%= rFrameClass %>" style="width: 32px; height: 32px; padding: 2px;">
                                                        <div class="avatar-glow"></div>
                                                        <img src="<%= reply.users ? reply.users.avatar : '/css/silly_duck.png' %>" alt="avatar" class="avatar-img" style="border-width: 1px;">
                                                        <% if (reply.users && reply.users.equipped_badge) { %>
                                                            <div class="avatar-corner" style="position: absolute; top: -4px; right: -4px; font-size: 0.7rem; background: rgba(0,0,0,0.6); border-radius: 50%; padding: 2px; z-index: 10; border: 1px solid gold; display: flex; justify-content: center; align-items: center; width: 14px; height: 14px;">
                                                                <%= getBadgeIcon(reply.users.equipped_badge) %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </a>
                                                <% if (reply.users && reply.users.equipped_badge) { %>
                                                    <div style="display: flex; flex-direction: column; align-items: center; margin-top: 4px; z-index: 2; line-height: 1.1;">
                                                        <span class="game-title <%= getTitleRarityClass(reply.users.equipped_badge) %>" style="white-space: nowrap; font-size: 0.45rem !important; padding: 1px 6px !important; animation: none !important; transform: none !important; height: auto !important; width: max-content !important;"><%= reply.users.equipped_badge %></span>
                                                        <span style="font-size: 0.4rem; color: #ffd700; letter-spacing: 1px; text-shadow: 0 0 2px rgba(255,255,255,0.3); margin-top: 2px;"><%= getStarsByChapters(reply.users.user_stats ? reply.users.user_stats.chapters_read : 0) %></span>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div style="flex: 1;">
                                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.2rem;">
                                                    <span style="font-weight: 600; font-size: 0.88rem;">
                                                        <a href="/user/<%= reply.user_id %>" style="text-decoration: none; color: inherit; transition: color 0.2s;" onmouseover="this.style.color='var(--accent-color)'" onmouseout="this.style.color='inherit'">
                                                            <%= reply.users ? reply.users.display_name : 'Độc giả ẩn danh' %>
                                                        </a>
                                                    </span>
                                                    <span style="font-size: 0.75rem; color: var(--text-secondary);"><%= new Date(reply.created_at).toLocaleDateString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %></span>
                                                </div>
                                                <div class="comment-content" style="font-size: 0.86rem; line-height: 1.5; color: var(--text-primary); white-space: pre-wrap; margin-bottom: 0.4rem;"><%- formatCommentContent(reply.content) %></div>
                                                <div style="display: flex; align-items: center; gap: 1rem;">
                                                    <button onclick="likeComment(<%= reply.id %>)" class="like-btn" style="background: none; border: none; color: <%= reply.user_liked ? 'var(--accent-color)' : 'var(--text-secondary)' %>; cursor: pointer; display: flex; align-items: center; gap: 0.2rem; font-size: 0.75rem; padding: 0;">
                                                        ❤️ <span class="likes-count"><%= reply.likes_count %></span> Thích
                                                    </button>
                                                    <% if (typeof user !== 'undefined' && user) { %>
                                                        <button onclick="showReplyForm(<%= reply.id %>, '<%= reply.users ? reply.users.display_name : '' %>', <%= comment.id %>)" style="background: none; border: none; color: var(--text-secondary); cursor: pointer; padding: 0; font-size: 0.75rem;">
                                                            💬 Trả lời
                                                        </button>
                                                    <% } %>
                                                    <% if (typeof user !== 'undefined' && user && (user.id === reply.user_id || user.role === 'admin' || user.role === 'sp_admin')) { %>
                                                        <button onclick="deleteComment(<%= reply.id %>)" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 0; font-size: 0.75rem; display: flex; align-items: center; gap: 0.2rem;">
                                                            🗑️ Xóa
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Form trả lời cho từng reply -->
                                        <div id="reply-form-<%= reply.id %>" style="display: none; margin-top: 0.5rem; background: rgba(0,0,0,0.15); border-radius: 8px; padding: 0.8rem; width: 100%;">
                                            <textarea id="reply-textarea-<%= reply.id %>" placeholder="Viết câu trả lời của bạn..." required style="width: 100%; min-height: 60px; padding: 0.5rem 0.8rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); font-size: 0.85rem; line-height: 1.4; resize: vertical; margin-bottom: 0.5rem;"></textarea>
                                            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                                                <button onclick="cancelReply(<%= reply.id %>)" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px;">Hủy</button>
                                                <button onclick="submitReply(<%= comment.id %>, <%= reply.id %>)" class="btn btn-primary" style="font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px;">Trả lời</button>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>

                        <!-- Form trả lời ẩn -->
                        <div id="reply-form-<%= comment.id %>" style="display: none; margin-top: 1rem; background: rgba(0,0,0,0.15); border-radius: 8px; padding: 0.8rem;">
                            <textarea id="reply-textarea-<%= comment.id %>" placeholder="Viết câu trả lời của bạn..." required style="width: 100%; min-height: 60px; padding: 0.5rem 0.8rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); font-size: 0.85rem; line-height: 1.4; resize: vertical; margin-bottom: 0.5rem;"></textarea>
                            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                                <button onclick="cancelReply(<%= comment.id %>)" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px;">Hủy</button>
                                <button onclick="submitReply(<%= comment.id %>)" class="btn btn-primary" style="font-size: 0.75rem; padding: 0.3rem 0.8rem; border-radius: 6px;">Trả lời</button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<script>
    // Xử lý gửi bình luận chính
    const commentForm = document.getElementById('comment-form');
    if (commentForm) {
        commentForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const textarea = document.getElementById('comment-textarea');
            const content = textarea.value;
            const storyId = '<%= story.id %>';

            try {
                const resp = await fetch(`/story/${storyId}/comment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        content,
                        chapter_number: null
                    })
                });
                const data = await resp.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.error);
                }
            } catch (err) {
                alert('Lỗi hệ thống: ' + err.message);
            }
        });
    }

    // Like bình luận
    async function likeComment(commentId) {
        try {
            const resp = await fetch(`/comment/${commentId}/like`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await resp.json();
            if (data.success) {
                const commentItem = document.getElementById(`comment-${commentId}`);
                const likeBtn = commentItem.querySelector('.like-btn');
                const likesCountSpan = likeBtn.querySelector('.likes-count');
                
                likesCountSpan.textContent = data.likesCount;
                likeBtn.style.color = data.liked ? 'var(--accent-color)' : 'var(--text-secondary)';
            }
        } catch (err) {
            console.error('Lỗi khi like bình luận:', err);
        }
    }

    // Hiển thị khung trả lời bình luận
    function showReplyForm(targetId, displayName, rootParentId) {
        document.querySelectorAll('[id^="reply-form-"]').forEach(f => f.style.display = 'none');
        
        const form = document.getElementById(`reply-form-${targetId}`);
        const textarea = document.getElementById(`reply-textarea-${targetId}`);
        if (form && textarea) {
            form.style.display = 'block';
            textarea.value = `@${displayName} `;
            textarea.focus();
        }
    }

    function cancelReply(commentId) {
        const form = document.getElementById(`reply-form-${commentId}`);
        if (form) form.style.display = 'none';
    }

    // Gửi phản hồi bình luận
    async function submitReply(parentCommentId, targetReplyId) {
        const inputId = targetReplyId || parentCommentId;
        const textarea = document.getElementById(`reply-textarea-${inputId}`);
        const content = textarea ? textarea.value : '';
        const storyId = '<%= story.id %>';

        if (!content || !content.trim()) {
            alert('Vui lòng điền nội dung phản hồi.');
            return;
        }

        try {
            const resp = await fetch(`/story/${storyId}/comment`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    content,
                    chapter_number: null,
                    parent_id: parentCommentId
                })
            });
            const data = await resp.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Lỗi: ' + data.error);
            }
        } catch (err) {
            alert('Lỗi: ' + err.message);
        }
    }

    // Xóa bình luận
    async function deleteComment(commentId) {
        if (!confirm('Bạn có chắc chắn muốn xóa bình luận này?')) return;
        try {
            const resp = await fetch(`/comment/${commentId}/delete`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await resp.json();
            if (data.success) {
                const commentEl = document.getElementById(`comment-${commentId}`);
                if (commentEl) {
                    commentEl.remove();
                } else {
                    location.reload();
                }
            } else {
                alert(data.error || 'Lỗi khi xóa bình luận.');
            }
        } catch (err) {
            console.error('Lỗi khi xóa bình luận:', err);
            alert('Lỗi hệ thống khi xóa bình luận.');
        }
    }
</script>

<%- include('partials/footer') %>
